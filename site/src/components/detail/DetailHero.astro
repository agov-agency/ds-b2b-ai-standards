---
// Detail-page hero (scenario, skill, rule): band on the item's cover colour, white card left, big illustration right.
// Slots: "actions" (buttons under the lead), "facts" (extra <div><dt/><dd/></div> cells before `facts`), "art" (illustration).
import type { CollectionEntry } from 'astro:content';
import SiteHeader from '../SiteHeader.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Byline from '../Byline.astro';
interface Props {
  cover?: number;
  crumbs: { label: string; href?: string }[];
  chips: { label: string; out?: boolean }[];
  author?: CollectionEntry<'authors'>;
  title: string;
  lead?: string;
  facts?: [string, string][];
}
const { cover, crumbs, chips, author, title, lead, facts = [] } = Astro.props;
const hasFacts = facts.length > 0 || Astro.slots.has('facts');
---
<div class="top" style={cover ? `--cover: var(--pastel-${cover}); --cover-200: var(--pastel-${cover}-200); --cover-450: var(--pastel-${cover}-450)` : undefined}>
  <SiteHeader />
  <div class="wrap hero">
    <Breadcrumbs items={crumbs} />
    <div class="hero-row">
      <div class="hcard">
        <div class="pitch">
          <div class="meta">
            <p class="chips">{chips.map((c) => <span class:list={['chip', { out: c.out }]}>{c.label}</span>)}</p>
            <Byline author={author} link />
          </div>
          <h1 class="headline t-display">{title}</h1>
          {lead && <p class="lead t-p1">{lead}</p>}
          {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
        </div>
        {hasFacts && (
          <dl class="facts">
            <slot name="facts" />
            {facts.map(([k, v]) => <div><dt class="lbl">{k}</dt><dd class="t-p2">{v}</dd></div>)}
          </dl>
        )}
      </div>
      <div class="hart" aria-hidden="true"><slot name="art" /></div>
    </div>
  </div>
</div>
<script is:inline>{ const t = document.currentScript.previousElementSibling; document.documentElement.style.setProperty('--intro-y', Math.max(0, innerHeight - t.getBoundingClientRect().bottom) + 24 + 'px'); }</script>

<style>
  .top { position: relative; background: var(--cover, var(--bg-subtle)); }
  .hero { display: grid; gap: 32px; padding-block: 32px 64px; } /* breadcrumbs: same space above as below */
  /* start, not center: a centred card drifts away from the breadcrumbs when the illustration is taller */
  .hero-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: start; }
  /* White card; the facts sit under the pitch, split by one edge-to-edge divider */
  .hcard { grid-column: 1 / span 6; display: grid; border-radius: var(--radius-4); background: var(--neutral-0); box-shadow: inset 0 0 0 1px var(--line-card); }
  .pitch { display: grid; justify-items: start; padding: 40px; }
  .meta { justify-self: stretch; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .hcard .headline { max-width: none; }
  .lead { max-width: 56ch; margin-top: var(--gap-body); color: var(--text-body); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  /* Label + value cells, two per row */
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--gutter); padding: 32px 40px 40px; border-top: 1px solid var(--line-card); }
  .facts > :global(div) { display: grid; gap: 8px; align-content: start; }
  .facts :global(dt) { color: var(--text-2); }
  .facts :global(dd) { color: var(--text); }
  /* The card sets the hero's height; the illustration fits inside it, centred and nudged right */
  .hart { grid-column: 7 / -1; align-self: stretch; position: relative; translate: 5% 0; }
  .hart > :global(svg), .hart > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  /* Skill and rule icons sit inset, so a single object doesn't outgrow the scenario figures */
  .hart > :global(.kart) { position: absolute; inset: 12%; }
  @media (max-width: 999px) {
    .hero-row { grid-template-columns: 1fr; }
    .hcard, .hart { grid-column: 1; }
    .hart { order: -1; max-width: 520px; justify-self: center; translate: none; padding: 24px; }
    .hart > :global(svg), .hart > :global(img) { position: static; height: auto; max-height: 560px; }
    .hart:empty { display: none; }
    .hart > :global(.kart) { position: relative; inset: auto; width: min(100vw - 112px, 360px); aspect-ratio: 4 / 3; } /* the box has no width of its own here: viewport less margins and its padding */
  }
  @media (max-width: 699px) {
    .hero { padding-block: 32px 40px; }
    .pitch { padding: 24px; }
    .meta { margin-bottom: 16px; }
    .actions { margin-top: 24px; }
    .facts { grid-template-columns: 1fr; padding: 24px; }
  }
  /* Page intro (~0.5s), after the report's progress screen: the page opens in the cover colour, the card and the illustration rise in
     one after the other, the lit parts switch on, then the white page below slides up over the colour like the report's panel.
     Fades are shorter than the moves so things settle softly; ::after holds the colour under the hero until the white has arrived */
  @media (prefers-reduced-motion: no-preference) {
    .top { --intro-out: cubic-bezier(.22, 1, .36, 1); }
    .top::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 100dvh; background: inherit; pointer-events: none; animation: intro-hold 500ms step-end forwards; }
    .hero > :global(:first-child), .hcard, .hart { animation: intro-fade 200ms ease-out backwards, intro-rise 340ms var(--intro-out) backwards; }
    .hcard { animation-delay: 30ms; }
    .hart { animation: intro-fade 220ms ease-out 60ms backwards, intro-grow 400ms var(--intro-out) 60ms backwards; }
    /* Lights on, one beat after the drawing: scenario cover glow, then the hairline icon's accent strokes and dots */
    .hart :global(:is(.glass, .halo, .ring, .sig)) { animation: intro-fade 180ms ease-out 200ms backwards; }
    .hart :global(:is(.halo, .ring)) { animation-delay: 230ms; }
    .hart :global(.sig) { animation-delay: 260ms; }
    .hart :global(.hl .hi) { animation: intro-hi 200ms ease-out 200ms backwards; }
    .hart :global(.hl .dot:not(.m, .off)) { animation: intro-dot 200ms ease-out 240ms backwards; }
    .top ~ :global(main) { background: var(--bg); }
    .top ~ :global(*) { animation: intro-slide 340ms cubic-bezier(.32, .72, 0, 1) 160ms backwards; }
  }
  @keyframes intro-fade { from { opacity: 0; } }
  @keyframes intro-rise { from { transform: translateY(16px); } }
  @keyframes intro-grow { from { transform: translateY(16px) scale(.97); } }
  @keyframes intro-hi { from { stroke: var(--hairline-mid); } }
  @keyframes intro-dot { from { fill: var(--hairline-lo); } }
  /* --intro-y: from just below the fold, measured by the script under the hero */
  @keyframes intro-slide { from { transform: translateY(var(--intro-y, 100dvh)); } }
  @keyframes intro-hold { to { visibility: hidden; } }
</style>
