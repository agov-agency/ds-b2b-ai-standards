---
// "What you get": slot "lead" sits above the gallery, the default slot below it. A row of images, each about three quarters of the content column, cropped only at the vertical lines; it scrolls sideways (trackpad, swipe) and the arrows in the section head step one image, wrapping from the last back to the first.
import Sec from '../Sec.astro';
import { arrow } from '../../arrows';
interface Item { title: string; caption: string; src?: string }
interface Props { id?: string; label?: string; title: string; context?: string; items: Item[] }
const { id = 'h-back', label = 'What you get', title, context, items } = Astro.props;
---
<Sec id={id} label={label} title={title} context={context} small>
  <Fragment slot="act">
    <button class="btn outlined icon xs" type="button" data-prev aria-label="Previous output" disabled={items.length < 2}><Fragment set:html={arrow('left')} /></button>
    <button class="btn filled icon xs" type="button" data-next aria-label="Next output" disabled={items.length < 2}><Fragment set:html={arrow('right')} /></button>
  </Fragment>
  <slot name="lead" />
  <ul class="gal" data-gal tabindex="0" aria-label="Outputs">
    {items.map((o, i) => (
      <li class="slide">
        {o.src ? <img src={o.src} alt={`${o.title}: ${o.caption}`} loading={i < 2 ? undefined : 'lazy'} /> : <span class="ph pattern" role="img" aria-label={`${o.title} (image to come)`} />}
      </li>
    ))}
  </ul>
  <slot />
</Sec>

<script>
  // Arrows: own tween (snap off while it runs, as in rail.ts) one image over; past either end it runs back round
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-gal]').forEach((gal) => {
    const sec = gal.closest('section')!;
    const prev = sec.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = sec.querySelector<HTMLButtonElement>('[data-next]')!;
    if (gal.children.length < 2) return;
    let raf = 0, target = 0;
    const go = (to: number) => {
      target = to;
      if (reduce.matches) { gal.scrollLeft = to; return; }
      cancelAnimationFrame(raf);
      const from = gal.scrollLeft, dist = to - from, t0 = performance.now(), dur = 500;
      gal.style.scrollSnapType = 'none';
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        gal.scrollLeft = from + dist * (1 - Math.pow(1 - p, 3));
        if (p < 1) raf = requestAnimationFrame(tick); else { raf = 0; gal.style.scrollSnapType = ''; }
      };
      raf = requestAnimationFrame(tick);
    };
    const step = (d: number) => {
      const s = (gal.firstElementChild as HTMLElement).offsetWidth + parseFloat(getComputedStyle(gal).columnGap || '0');
      const max = gal.scrollWidth - gal.clientWidth;
      const at = raf ? target : gal.scrollLeft;
      if (d > 0 && at >= max - 4) return go(0);
      if (d < 0 && at <= 4) return go(max);
      go(Math.max(0, Math.min(max, Math.round((at + d * s) / s) * s)));
    };
    prev.onclick = () => step(-1);
    next.onclick = () => step(1);
    gal.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { e.preventDefault(); step(1); } if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); } });
  });
</script>

<style>
  /* Each image is three quarters of the content column; the row runs out to the vertical lines (--pad from the detail frame) and crops there */
  .gal { display: grid; grid-auto-flow: column; grid-auto-columns: 75%; gap: var(--gutter); margin-inline: calc(-1 * var(--pad, 0px)); padding: 4px var(--pad, 0px); scroll-padding-inline: var(--pad, 0px); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; outline-offset: -4px; }
  .gal::-webkit-scrollbar { display: none; }
  .slide { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-4); background: var(--bg-subtle); overflow: hidden; scroll-snap-align: start; }
  .slide::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px var(--line-card); pointer-events: none; } /* over the image, which hides an inset ring on the slide itself */
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .ph { position: absolute; inset: 0; opacity: .5; }
  @media (max-width: 699px) { .gal { grid-auto-columns: 88%; } }
</style>
