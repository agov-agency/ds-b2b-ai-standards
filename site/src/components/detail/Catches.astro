---
// "What it catches" (scenario page): two-tone headline, a larger reading paragraph (or several, split on blank lines)
// held to a readable measure, then the findings as grid cards. Editors add or remove cards freely.
import Sec from '../Sec.astro';
import Tiles from './Tiles.astro';
interface Props { label?: string; headline: string; context?: string; body?: string; note?: string; findings?: { title: string; text: string }[] }
const { label = 'What it catches', headline, context, body, note, findings = [] } = Astro.props;
const paras = body?.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) ?? [];
---
<Sec id="h-catches" label={label} title={headline} context={context} small class:list={['first', { flush: findings.length > 0 }]}>
  {(paras.length > 0 || note) && (
    <div class:list={['read', { gap: findings.length > 0 }]} data-reveal>
      {paras.map((p) => <p class="lead">{p}</p>)}
      {note && <p class="lbl-2 note">{note}</p>}
    </div>
  )}
  {findings.length > 0 && <Tiles items={findings} />}
</Sec>

<style>
  /* ~65 characters a line at 20px: a reading measure, not the section width */
  .read { display: grid; gap: 16px; max-width: 34em; font-size: 20px; }
  .read.gap { margin-bottom: 48px; }
  .lead { color: var(--text); font: 500 1em/1.5 var(--font-sans); letter-spacing: -.03em; }
  .note { color: var(--text-2); margin-top: 8px; }
  @media (max-width: 699px) { .read { font-size: 18px; } .read.gap { margin-bottom: 32px; } }
</style>
