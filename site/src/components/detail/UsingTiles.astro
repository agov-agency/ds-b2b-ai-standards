---
// "Using it" (scenario and skill pages): headline over grid cards.
import Sec from '../Sec.astro';
import Tiles from './Tiles.astro';
interface Props { id?: string; label?: string; headline?: string; context?: string; items: { icon?: string; title: string; text: string }[] }
const { id = 'h-using', label = 'Using it', headline = 'Before the first run.', context = 'What it needs, what it leaves alone and what makes it stop', items } = Astro.props;
---
<Sec id={id} label={label} title={headline} context={context} small class="flush">
  <Tiles items={items} />
</Sec>
