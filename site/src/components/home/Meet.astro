---
// Authors + form (home §7), the submit landing's #get scene reused: a sticky stage holds the centred headline while the
// author cards scroll up past it, left and right. Once the last card is past, the same headline turns into the ask,
// lets go of the screen and rides up with the form right under it (white on black), so people and form read as one story.
// Below 1000 the cards become a rail and the stage stops sticking. Ref: zade.space "Why founders build it with us".
import { getCollection } from 'astro:content';
import { arrow } from '../../arrows';
import AuthorCard from '../AuthorCard.astro';
// Best-known and most active first (Agov's pick, shown even if not featured), then the other featured authors by CMS order
const FRONT = ['justin-rowe', 'joshua-stout', 'jonathan-belliveau', 'aj-wilcox', 'bogdan-liutic', 'ivars-krutainis', 'ivan-falco'];
const rank = (id: string) => (FRONT.includes(id) ? FRONT.indexOf(id) : FRONT.length);
const authors = (await getCollection('authors', (a) => a.data.featured || FRONT.includes(a.id)))
  .sort((a, b) => rank(a.id) - rank(b.id) || a.data.order - b.data.order).slice(0, 8);
const X = [0, 1, .04, .96, 0, 1, .06, .94]; // card offsets across the grid, flanking the headline
const DY = ['0svh', '6svh', '-4svh', '4svh', '2svh', '-2svh', '4svh', '0svh'];
const check = '<svg viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M6 11C8.7614 11 11 8.7614 11 6C11 3.23857 8.7614 1 6 1C3.23857 1 1 3.23857 1 6C1 8.7614 3.23857 11 6 11ZM8.72855 4.72856L5.5 7.9571L3.39645 5.85355L4.10356 5.14645L5.5 6.5429L8.02145 4.02144L8.72855 4.72856Z"/></svg>'; // Figma icon/check-cricle, as on the report form
const TO = 'znak@demontrend.com'; // the submit landing's contact until a form backend exists
---
<section class="meet surface-black ruled spotsec" data-spot="front" aria-labelledby="h-meet" data-meet>
  <div class="track">
    <!-- Followspot from the submit landing (illustrations/spotlight.js): a screen-high layer that sticks with the headline;
         the script draws the lamp and lays the beam over it, resting on the [data-rest] headline -->
    <div class="stage" aria-hidden="true">
      <svg class="beam"><defs>
        <linearGradient id="meet-beam" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="var(--primary-300)" stop-opacity=".55"/><stop offset=".35" stop-color="var(--primary-450)" stop-opacity=".22"/><stop offset="1" stop-color="var(--primary-450)" stop-opacity=".06"/></linearGradient>
        <radialGradient id="meet-pool"><stop offset="0" stop-color="var(--primary-300)" stop-opacity=".34"/><stop offset=".55" stop-color="var(--primary-450)" stop-opacity=".16"/><stop offset="1" stop-color="var(--primary-450)" stop-opacity="0"/></radialGradient>
        <filter id="meet-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="32"/></filter>
      </defs>
        <g filter="url(#meet-blur)">
          <path class="cone" fill="url(#meet-beam)"/><path class="core" fill="url(#meet-beam)"/><ellipse class="pool" fill="url(#meet-pool)"/>
          <g class="ghosts"><circle/><circle/><circle/></g>
          <ellipse class="fringe a"/><ellipse class="fringe b"/>
        </g>
      </svg>
      <figure class="lampfig"><svg></svg></figure>
    </div>
    <div class="pin" data-rest>
      <div class="wrap heads" data-heads>
        <h2 id="h-meet" class="headline t-display h-a">Nobody here is describing best practice <span class="tone-2">from the outside</span></h2>
        <p class="headline t-display h-b">You run an account a way that works. <span class="tone-2">Send it</span></p>
      </div>
    </div>
    <ul class="wrap deck">
      {authors.map((a, i) => <li style={`--x: ${X[i % X.length]}; --dy: ${DY[i % DY.length]}`}><AuthorCard author={a} /></li>)}
    </ul>
    <div class="swap-at" data-swap aria-hidden="true"></div>
  </div>

  <div class="wrap send">
    <!-- Stepped form, as the report's request form (Figma 996:24441): numbered steps on a rail, two-tone step headlines -->
    <form class="card" action={`mailto:${TO}`} method="post" enctype="text/plain" data-send>
      <fieldset class="step">
        <span class="n" aria-hidden="true">1</span>
        <legend class="t-h5">Who’s sending it? <span class="tone-2">We publish it under your name</span></legend>
        <div class="grid2">
          <label class="f"><span class="lbl">Your name</span><input name="name" autocomplete="name" required placeholder="Full name"></label>
          <label class="f"><span class="lbl">Work email</span><input name="email" type="email" autocomplete="email" required placeholder="name@company.com"></label>
        </div>
        <label class="f"><span class="lbl">Company</span><input name="company" autocomplete="organization" placeholder="Where you run LinkedIn Ads"></label>
      </fieldset>
      <fieldset class="step">
        <span class="n" aria-hidden="true">2</span>
        <legend class="t-h5">What are you bringing? <span class="tone-2">A rule, a skill or a whole scenario</span></legend>
        <div class="opts" role="radiogroup" aria-label="What you’re bringing">
          {['A rule', 'A skill', 'A scenario'].map((o, i) => <label class="opt"><input type="radio" name="kind" value={o} checked={i === 0}><span>{o}</span></label>)}
        </div>
      </fieldset>
      <fieldset class="step">
        <span class="n" aria-hidden="true">3</span>
        <legend class="t-h5">Tell us about it <span class="tone-2">What it checks and how often you run it</span></legend>
        <textarea name="about" rows="3" aria-label="Tell us about it" placeholder="Every Monday I pull the demographics report and flag the company sizes we never meant to pay for…"></textarea>
      </fieldset>
      <div class="step last">
        <span class="n" aria-hidden="true">4</span>
        <button class="btn brand go-btn" type="submit">
          <span class="go-txt"><span>Send it</span><span class="ticks lbl-2">{['Free', 'Your name on it', 'Your links on it'].map((t) => <span><Fragment set:html={check} />{t}</span>)}</span></span>
          <Fragment set:html={arrow('right', 'go')} />
        </button>
      </div>
    </form>
  </div>
</section>

<script is:inline src="/illustrations/spotlight.js" defer></script>

<script>
  // Headline swap: once the marker after the last card rises past the stage centre, show the ask
  for (const sec of document.querySelectorAll<HTMLElement>('[data-meet]')) {
    const at = sec.querySelector('[data-swap]')!;
    // the form sits half a headline below the stage's centre line, so it needs the headline's height
    const heads = sec.querySelector<HTMLElement>('[data-heads]')!;
    new ResizeObserver(() => sec.style.setProperty('--hh', `${heads.offsetHeight}px`)).observe(heads);
    // a scroll check, not an IntersectionObserver: a fast jump can skip the marker without any crossing to report
    const sync = () => sec.classList.toggle('asked', at.getBoundingClientRect().top < innerHeight / 2);
    addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  }
  // No form backend yet: compose the email in the visitor's mail app with the fields filled in
  document.querySelectorAll<HTMLFormElement>('[data-send]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const body = ['name', 'email', 'company', 'kind', 'about'].map((k) => `${k}: ${d.get(k) ?? ''}`).join('\n');
    location.href = `${f.action.split('?')[0]}?subject=${encodeURIComponent(`Contribution: ${d.get('kind')}`)}&body=${encodeURIComponent(body)}`;
  }));
</script>

<style>
  .meet { --cw: 280px; --ch: 340px; position: relative; isolation: isolate; overflow: clip; background: var(--bg); color: var(--text); }
  .pin { display: grid; place-items: center; padding-block: var(--section-ruled-top) 48px; }
  .stage { display: none; }
  /* Beam and lamp, as on the submit landing; the script fills them in */
  .beam { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; mix-blend-mode: screen; opacity: 0; transition: opacity 900ms var(--ease-out) 450ms; }
  .meet:global(.on) .beam { opacity: .8; }
  .beam .core { opacity: .4; }
  .beam .ghosts circle { fill: none; stroke: var(--primary-300); stroke-opacity: .1; }
  .beam .ghosts circle:nth-child(2) { fill: var(--primary-450); fill-opacity: .06; stroke: none; }
  .beam .fringe { fill: none; stroke-width: 1; }
  .beam .fringe.a { stroke: var(--primary-300); stroke-opacity: .12; }
  .beam .fringe.b { stroke: var(--primary-450); stroke-opacity: .16; }
  .lampfig :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .lampfig :global(path) { fill: var(--neutral-1000); stroke: var(--neutral-800); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linejoin: miter; }
  .lampfig :global(.nf) { fill: none; }
  .lampfig :global(.lo) { stroke: var(--neutral-850); }
  .lampfig :global(.sil) { stroke: var(--neutral-500); }
  .lampfig :global(.lens) { fill: var(--primary-450); fill-opacity: .35; stroke: var(--primary-300); }
  .lampfig :global(.halo) { fill-opacity: .6; }
  .lampfig { opacity: 0; translate: 0 -12px; transition: opacity 600ms var(--ease-out), translate 600ms var(--ease-out); }
  .meet:global(.on) .lampfig { opacity: 1; translate: 0 0; }
  .heads { display: grid; justify-items: center; width: 100%; text-align: center; }
  .heads > * { grid-area: 1 / 1; align-self: end; max-width: 13em; margin-inline: auto; text-wrap: balance; transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out); }
  .h-b { opacity: 0; transform: translateY(14px); }
  .meet.asked .h-a { opacity: 0; transform: translateY(-14px); }
  .meet.asked .h-b { opacity: 1; transform: none; }

  .deck li { border-radius: var(--radius-4); background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); overflow: hidden; }

  @media (min-width: 1000px) {
    /* Zero-height stage pinned at the screen's centre line; it lets go when the track ends, so the headline leaves with the form */
    .track { position: relative; }
    /* the pin starts at the first fold's centre line, so the headline opens centred in the section, not over its top edge */
    .pin { position: sticky; z-index: 1; top: calc(var(--site-bar) + (100svh - var(--site-bar)) / 2); display: block; height: 0; margin-top: calc((100svh - var(--site-bar)) / 2); padding: 0; }
    /* Spot layer: screen-high, sticks with the headline, takes no room in the flow */
    .stage { display: block; position: sticky; top: var(--site-bar); height: calc(100svh - var(--site-bar)); margin-bottom: calc(var(--site-bar) - 100svh); overflow: hidden; pointer-events: none; }
    .lampfig { position: absolute; top: -170px; left: calc(50% - 260px); width: 520px; margin: 0; -webkit-mask: linear-gradient(transparent 30%, #000 45%); mask: linear-gradient(transparent 30%, #000 45%); }
    .heads { transform: translateY(-50%); }
    /* the headline fits between the two card columns */
    .heads > * { max-width: calc(100% - 2 * (var(--cw) + 64px)); font-size: clamp(36px, 4vw, 64px); }
      /* Deck scrolls over the stage: pulled up one stage height, the first card starting below the fold */
    .deck { position: relative; z-index: 1; display: block; padding-top: 60svh; pointer-events: none; --step: 26svh; }
    .deck li { pointer-events: auto; width: var(--cw); height: var(--ch); margin-left: calc((100% - var(--cw)) * var(--x)); }
    .deck li + li { margin-top: calc(var(--step) + var(--dy, 0px) - var(--ch)); }
    .swap-at { height: 30svh; }
    /* Cards come in from below and leave at the top (scroll-driven where supported, plain scroll elsewhere) */
    @supports (animation-timeline: view()) {
      .deck li { animation: life linear both; animation-timeline: view(); }
      @keyframes life { 0% { opacity: 0; transform: translateY(40px) scale(.96); } 20%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(-24px) scale(.96); } }
    }
  }

  /* Form: white card on black, right under the ask */
  .send { position: relative; z-index: 2; padding-block: calc(var(--hh, 140px) / 2 + 48px) 20svh; /* both headlines sit on the cell bottom, so this is a fixed 48px under the ask */ }
  .card { --bg: var(--neutral-0); --text: var(--neutral-950); --text-2: var(--neutral-500); --text-body: var(--neutral-800); --line-field: var(--neutral-100); --line: var(--neutral-100);
    display: grid; max-width: 650px; margin-inline: auto; padding: 40px 40px 48px; border-radius: var(--radius-4); background: var(--bg); color: var(--text); }
  /* Steps: number on the left rail, a line runs from each number down to the next */
  .step { position: relative; display: grid; gap: 20px; margin: 0; padding: 0 0 32px 76px; border: 0; min-width: 0; }
  .step::before { content: ''; position: absolute; left: 23px; top: 48px; bottom: 0; width: 1px; background: var(--neutral-100); }
  .step.last { padding-bottom: 0; }
  .step.last::before { display: none; }
  .n { position: absolute; left: 4px; top: 0; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--neutral-50); box-shadow: 0 0 0 4px var(--neutral-0), 0 0 0 5px var(--neutral-75); font: 600 12px/1 var(--font-mono); }
  .step.last .n { top: 12px; }
  legend { float: left; width: 100%; padding: 0; }
  legend .tone-2 { display: block; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; }
  .f { display: grid; gap: 4px; min-width: 0; }
  .f .lbl { color: var(--text); }
  /* Report share form: underlined fields, no box */
  input:not([type=radio]), textarea { width: 100%; min-height: 42px; padding: 8px 0; border: 0; border-bottom: 1px solid var(--line-field); border-radius: 0; background: none; color: var(--text); font: 500 16px/1.4 var(--font-sans); letter-spacing: -.03em; outline: 0; resize: vertical; transition: border-color var(--t-fast) ease; }
  :is(input, textarea)::placeholder { color: var(--text-2); opacity: .8; }
  input:focus-visible, textarea:focus-visible { border-color: var(--text); }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span { display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1px var(--neutral-200); font: 600 12px/1 var(--font-mono); text-transform: uppercase; cursor: pointer; transition: background-color var(--t-fast) ease, color var(--t-fast) ease, box-shadow var(--t-fast) ease; }
  .opt input:checked + span { background: var(--neutral-950); color: var(--neutral-0); box-shadow: none; }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Primary blue, full width, the promises under the label (as the report's "Get my free report") */
  .go-btn { justify-content: space-between; width: 100%; height: auto; min-height: 64px; padding: 12px 28px; gap: 16px; font-size: 16px; text-align: left; }
  .go-btn :global(svg) { width: 28px; height: 28px; }
  .go-txt { display: grid; gap: 4px; }
  .ticks { display: flex; flex-wrap: wrap; gap: 4px 12px; color: var(--neutral-0); }
  .ticks > span { display: inline-flex; align-items: center; gap: 4px; }
  .ticks :global(svg) { width: 12px; height: 12px; }
  @media (hover: hover) and (pointer: fine) { .opt span:hover { box-shadow: inset 0 0 0 1px var(--text); } }

  @media (max-width: 999px) {
    .meet { padding-bottom: var(--section-ruled-bottom); }
      .deck { display: grid; grid-auto-flow: column; grid-auto-columns: min(80%, 320px); gap: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--edge-inset)); padding-inline: var(--edge-inset); scroll-padding-inline: var(--edge-inset); max-width: none; }
    .deck li { scroll-snap-align: start; }
    .send { margin-top: 48px; padding: 0; }
    .h-b { display: none; }
    .meet.asked .h-a { opacity: 1; transform: none; }
    .card { padding: 32px; }
  }
  @media (max-width: 699px) {
    .card { padding: 24px 20px; }
    .grid2 { grid-template-columns: minmax(0, 1fr); }
    .step { padding-left: 52px; }
    .n { left: 0; width: 32px; height: 32px; }
    .step::before { left: 16px; top: 40px; }
    .go-btn { padding-inline: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .heads > * { transition: opacity 200ms linear; transform: none !important; }
    .deck li { animation: none !important; }
  }
</style>
