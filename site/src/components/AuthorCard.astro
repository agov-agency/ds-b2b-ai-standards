---
// Author card: photo, company and role chips, name, a 2-line bio (lowest priority), chips for their work. Initials stand in until photos arrive.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { T } from '../site';
interface Props { author: CollectionEntry<'authors'> }
const { id, data } = Astro.props.author;
const mine = (e: { data: { author?: { id: string } } }) => e.data.author?.id === id;
const nSc = (await getCollection('scenarios', mine)).length;
const nSk = (await getCollection('skills', mine)).length;
const work = [
  nSc && { type: 'scenario', text: `${nSc} ${(nSc === 1 ? T.scenario : T.scenarios).toLowerCase()}` },
  nSk && { type: 'skill', text: `${nSk} ${(nSk === 1 ? T.skill : T.skills).toLowerCase()}` },
].filter((w) => !!w);
const initials = data.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<a class="acard" href={`/authors/${id}`}>
  <span class="photo">
    {data.photo
      ? <img src={data.photo} alt="" loading="lazy" />
      : <><span class="pattern dots" aria-hidden="true" /><span class="ini t-n2" aria-hidden="true">{initials}</span></>}
  </span>
  <span class="txt">
    {(data.company || data.role) && <span class="job">{data.company && <span class="chip co">{data.company}</span>}{data.role && <span class="chip role">{data.role}</span>}</span>}
    <span class="t-h6 name">{data.name}</span>
    {data.about && <span class="t-p2 about">{data.about}</span>}
  </span>
  {work.length > 0 && <span class="work">{work.map((w) => <span class="chip out" data-type={w.type}>{w.text}</span>)}</span>}
</a>

<style>
  /* Grid card: no frame of its own; the rail draws the cell lines */
  /* --in: side inset; a list can zero it on one side so the outer cards line up with the headline */
  /* --bleed-l/-r: how far the hover fill runs past the card, so an outer card's fill reaches the edge line */
  .acard { --in: 24px; --in-l: var(--in); --bleed-l: 0px; --bleed-r: 0px; --fill: transparent; display: grid; grid-template-rows: auto 1fr auto; height: 100%; padding-block: 16px 24px; overflow: hidden; background: var(--fill); box-shadow: calc(-1 * var(--bleed-l)) 0 var(--fill), var(--bleed-r) 0 var(--fill); transition: background-color var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out); }
  /* Round portrait, 96px, top-left of the card (the profile keeps its big one) */
  .photo { position: relative; display: grid; place-items: center; width: 96px; height: 96px; margin: 24px var(--in) 0 var(--in-l); border-radius: 50%; background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .dots { position: absolute; inset: 0; --dot: var(--neutral-100); }
  :global(.surface-black) .dots { --dot: var(--neutral-850); }
  .ini { position: relative; color: var(--text-meta); transition: color var(--t-fast) var(--ease-out); }
  .ini { font-size: 28px; }
  .txt { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; align-content: start; justify-items: start; padding: 24px var(--in) 0 var(--in-l); }
  /* Company, then role, as two chips on one line; then the name; the bio is the quietest line */
  .job { display: flex; gap: 4px; max-width: 100%; margin-bottom: 8px; }
  .job > .chip { display: block; overflow: hidden; text-overflow: ellipsis; }
  .co { flex: none; max-width: 100%; }
  .role { min-width: 0; } /* the role gives way first; the full title shows on the profile */
  .about { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 12px; color: var(--text-2); }
  /* Their work as chips, each marked with its type colour */
  .work { display: flex; flex-wrap: wrap; gap: 6px; margin: 24px var(--in) 0 var(--in-l); } /* the card's own bottom padding holds cards without work too */
  .work .chip::before { content: ''; width: 6px; height: 6px; background: var(--accent); flex: none; }
  .work .chip { color: var(--text); box-shadow: inset 0 0 0 1px var(--neutral-800); transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .acard:hover { --fill: var(--bg-subtle); }
    .acard:hover .ini { color: var(--text); }
    .acard:hover .work .chip { background: var(--neutral-0); color: var(--neutral-950); box-shadow: inset 0 0 0 1px var(--neutral-0); } /* fills white on hover */
  }
</style>
