---
// Hero and CTA art (DESIGN §8.17): an isometric piece straight on the section (or on a pastel field when given one).
// `dark` switches to the black-hero look: dark faces, grey hairlines, blue glow on the live part.
// `zoom` scales it around the piece's focus so the important part fills the box and the rest bleeds off; `place`
// instead pins it at an exact rect from the Figma layout: [right, top, width, height] in px, right measured from the
// box's right edge (plus --bleed, how far the box runs past its section). The build renders the rest frame;
// on the page it plays by itself (no pointer or key triggers), pauses off-screen and stays on the rest frame
// under reduced motion. `still` keeps the rest frame (icons). `hover` (scenario cards) rests until the pointer is over
// the card around it, then plays; it eases in and out of speed so it never jumps. Touch screens keep the rest frame.
import { pieces } from '../art';
interface Props { name: string; field?: string; dark?: boolean; blue?: boolean; mono?: boolean; zoom?: number; place?: [number, number, number, number]; clip?: number; accent?: 'scenario' | 'skill' | 'rule' | 'brand'; still?: boolean; hover?: boolean; class?: string }
const { name, field = 'transparent', dark = false, blue = false, mono = false, zoom = 1, place, clip, accent, still = false, hover = false, class: cls } = Astro.props;
const lit = accent ? `; --lit: ${accent === 'brand' ? `var(--primary-${dark ? 300 : 450})` : `var(--art-${{ scenario: 'a', skill: 'b', rule: 'c' }[accent]})`}` : '';
const piece = pieces[name];
const [fx, fy] = piece.focus ?? [0.5, 0.5];
const at = place ? `; --pr: ${place[0]}px; --pt: ${place[1]}px; --pw: ${place[2]}px; --ph: ${place[3]}px` : '';
---
<figure class:list={['iso-panel', cls]} data-iso={still ? undefined : name} data-hover={hover || undefined} style={`--field: ${field}; --zoom: ${zoom}; --fx: ${fx * 100}%; --fy: ${fy * 100}%${lit}${at}${clip ? `; --cw: ${clip}px` : ''}`}>
  <svg class:list={['iso-art', { 'on-dark': dark, 'on-blue': blue, mono, placed: place }]} viewBox={piece.viewBox} role="img" aria-label={piece.aria} preserveAspectRatio="xMidYMid meet">
    {(dark || blue) && <defs><filter id="iso-glow" filterUnits="userSpaceOnUse" x="-2000" y="-2000" width="6000" height="6000"><feGaussianBlur in="SourceGraphic" stdDeviation="10" result="b" /><feComponentTransfer in="b" result="g"><feFuncA type="linear" slope=".7" /></feComponentTransfer><feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge></filter></defs>}
    <g data-frame set:html={piece.draw(piece.rest)} />
  </svg>
</figure>

<script>
  import { figures } from '../art/figures';
  const still = matchMedia('(prefers-reduced-motion: reduce)'), canHover = matchMedia('(hover: hover) and (pointer: fine)');
  const SPEED = 0.6; // pieces are timed in brisk beats; played slower so each spring move takes about a second
  for (const host of document.querySelectorAll<HTMLElement>('[data-iso]')) {
    const piece = figures[host.dataset.iso!], frame = host.querySelector('[data-frame]')!;
    if (!piece) continue;
    const hover = host.hasAttribute('data-hover');
    let raf = 0, last = 0, t = piece.rest, v = 0, seen = false, over = !hover;
    // v is the play speed (0..1): it eases towards 1 while playing and back to 0 on hover out, then the loop stops
    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, .05), want = seen && over ? 1 : 0;
      last = now;
      v += (want - v) * Math.min(1, dt * 5);
      if (!want && v < .01) { raf = 0; return; }
      t += dt * SPEED * v;
      frame.innerHTML = piece.draw(t);
      host.style.setProperty('--march', String(-(t * 12) % 14)); // dashes travel along their path
      raf = requestAnimationFrame(tick);
    };
    const run = () => {
      if (still.matches || (hover && !canHover.matches)) return;
      if (!seen) { cancelAnimationFrame(raf); raf = 0; return; }
      if (over && !raf) { last = performance.now(); raf = requestAnimationFrame(tick); }
    };
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; run(); }).observe(host);
    if (hover) {
      const card = host.closest('a') ?? host;
      card.addEventListener('pointerenter', () => { over = true; run(); });
      card.addEventListener('pointerleave', () => { over = false; });
    }
  }
</script>

<style>
  .iso-panel { --art-a: var(--scenario-300); --art-b: var(--skill-300); --art-c: var(--rule-300); position: relative; margin: 0; background: var(--field); border-radius: var(--radius-4); overflow: hidden; }
  .iso-art { --ink: var(--neutral-950); --h: var(--art-a); position: absolute; inset: 4%; display: block; width: 92%; height: 92%; overflow: visible; transform: scale(var(--zoom)); transform-origin: var(--fx) var(--fy); }
  /* Pinned to the Figma layout on desktop; smaller screens fall back to fitting the box */
  @media (min-width: 1000px) { .iso-art.placed { inset: auto; right: calc(var(--pr) + var(--bleed, 0px)); top: var(--pt); width: var(--pw); height: var(--ph); transform: none; } }
  /* Hue groups a/b/c are the item type colours: scenario orange, skill cyan, rule blue */
  .iso-art :global(*) { vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
  .iso-art :global(.ha) { --h: var(--art-a); }
  .iso-art :global(.hb) { --h: var(--art-b); }
  .iso-art :global(.hc) { --h: var(--art-c); }
  .iso-art :global(.f) { stroke: var(--ink); stroke-width: var(--art-line); }
  .iso-art :global(.paper) { fill: #fff; }
  .iso-art :global(.tint) { fill: color-mix(in srgb, var(--h) 30%, #fff); }
  .iso-art :global(.body) { fill: color-mix(in srgb, var(--h) 60%, #fff); }
  .iso-art :global(.blk), .iso-art :global(.head) { fill: var(--ink); }
  .iso-art :global(.det) { fill: none; stroke: var(--ink); stroke-width: var(--art-detail); }
  .iso-art :global(.hl) { fill: none; stroke: var(--h); stroke-width: var(--art-line); }
  .iso-art :global(.dashed) { stroke-dasharray: 4 3; }
  .iso-art :global(.nofill) { fill: none; }
  .iso-art :global(.dash) { fill: none; stroke: var(--ink); stroke-width: var(--art-dash); stroke-dasharray: 6 5; stroke-linecap: butt; }
  /* A bent tube: an ink stroke with a paper stroke inside, so its outline matches .f; .flow runs along it */
  .iso-art :global(.tube-o) { fill: none; stroke: var(--ink); stroke-width: calc(3px + 2 * var(--art-line)); }
  .iso-art :global(.tube-i) { fill: none; stroke: #fff; stroke-width: 3px; }
  .iso-art :global(.flow) { fill: none; stroke: var(--lit, var(--h)); stroke-width: calc(2 * var(--art-dash)); stroke-dasharray: 3 4; stroke-linecap: butt; stroke-dashoffset: var(--march, 0); }
  .iso-art :global(.march) { stroke-dashoffset: var(--march, 0); }
  /* `mono` on a light surface: grey and white like the heroes, colour only on the live part */
  .iso-art.mono, .mono :global(:is(.ha, .hb, .hc)) { --h: var(--neutral-300); }
  .mono :global(.lit), .mono :global(.lit :is(.ha, .hb, .hc)) { --h: var(--lit, var(--primary-450)); }
  /* On black heroes (iso-glow look): dark faces, grey hairlines; only the live part (.lit) takes colour and glows:
     the hero's own item colour (`accent`), else the hue of the group it sits in */
  .on-dark { --line: color-mix(in srgb, var(--neutral-500) 55%, var(--neutral-800)); }
  .on-dark :global(.f) { stroke: var(--line); }
  .on-dark :global(.det) { stroke: var(--neutral-800); }
  .on-dark :global(.paper) { fill: var(--neutral-950); }
  .on-dark :global(.tint) { fill: var(--neutral-950); }
  .on-dark :global(.body) { fill: var(--neutral-1000); }
  .on-dark :global(.blk) { fill: var(--neutral-1000); }
  .on-dark :global(.dash) { stroke: var(--line); }
  .on-dark :global(.head) { fill: var(--line); }
  .on-dark :global(.lit) { filter: url(#iso-glow); }
  .on-dark :global(.lit .f) { stroke: var(--lit, var(--h)); }
  .on-dark :global(.lit .det) { stroke: color-mix(in srgb, var(--lit, var(--h)) 60%, var(--neutral-900)); }
  .on-dark :global(.lit .paper) { fill: color-mix(in srgb, var(--lit, var(--h)) 18%, var(--neutral-1000)); }
  .on-dark :global(.lit .tint) { fill: color-mix(in srgb, var(--lit, var(--h)) 30%, var(--neutral-1000)); }
  .on-dark :global(.lit .body) { fill: var(--lit, var(--h)); }
  /* `blue`: on the blue CTA card. Faces take the card colour, light white hairlines; the live part goes white and glows */
  .on-blue { --card: var(--primary-500); }
  /* Faces a step lighter than the card, so the machine lifts off the blue instead of melting into it */
  .on-blue :global(.f) { stroke: rgb(255 255 255 / .62); }
  .on-blue :global(.det) { stroke: rgb(255 255 255 / .32); }
  .on-blue :global(.paper) { fill: color-mix(in srgb, var(--neutral-0) 20%, var(--card)); }
  .on-blue :global(.tint) { fill: color-mix(in srgb, var(--neutral-0) 11%, var(--card)); }
  .on-blue :global(.body) { fill: color-mix(in srgb, var(--neutral-0) 5%, var(--card)); }
  .on-blue :global(.blk) { fill: color-mix(in srgb, var(--card) 60%, #000); }
  .on-blue :global(.lit) { filter: url(#iso-glow); }
  .on-blue :global(.lit .f) { stroke: var(--neutral-0); }
  .on-blue :global(.lit .paper) { fill: color-mix(in srgb, var(--neutral-0) 34%, var(--card)); }
  .on-blue :global(.lit .body) { fill: color-mix(in srgb, var(--neutral-0) 40%, var(--card)); }
  .iso-art :global(.type) { fill: var(--neutral-0); font: 600 10px/1 var(--font-mono); letter-spacing: 0; }
</style>
