---
// Library tabs (Collection, Scenarios, Skills, Rules), on the Collection and the three hubs only, never on detail pages. Page links, not ARIA tabs: each tab is its own page.
// Sits in the black hero; sticks under the fixed site header only once scrolled to it, stays black.
import { getCollection } from 'astro:content';
import { LIB_NAV } from '../site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const counts: Record<string, number> = {
  '/scenarios': (await getCollection('scenarios')).length,
  '/skills': (await getCollection('skills')).length,
  '/rules': (await getCollection('rules')).length,
};
const isCurrent = (href: string) => (href === '/collection' ? path === '/collection' || path === '/' : path.startsWith(href));
---
<div class="tab-sentinel" aria-hidden="true"></div>
<nav class="tabbar surface-black" aria-label="Library sections" data-tabbar>
  <div class="wrap">
    <ul class="tabs to-edges">
      {LIB_NAV.map((n) => (
        <li>
          <a class="tab" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
            {n.label}
            {counts[n.href] != null && <span class="n">{String(counts[n.href]).padStart(2, '0')}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const bar = document.querySelector('[data-tabbar]');
  const s = document.querySelector('.tab-sentinel');
  // Stuck once the sentinel above the bar passes under the fixed site header (read at scroll time: CSS may load after this script)
  const sync = () => {
    const stuck = !!s && s.getBoundingClientRect().top < (parseFloat(getComputedStyle(bar!).top) || 0);
    bar?.classList.toggle('stuck', stuck);
    // One bottom line for the whole nav stack: the header drops its own while the tabs sit under it
    document.querySelector('[data-site-header]')?.classList.toggle('tabs-stuck', stuck);
  };
  addEventListener('scroll', sync, { passive: true });
  sync();
</script>

<style>
  .tab-sentinel { height: 0; }
  .tabbar { position: sticky; top: var(--site-bar); z-index: var(--z-sticky); background: var(--bg); padding-block: 0 24px; transition: padding 200ms var(--ease-out), box-shadow 200ms var(--ease-out); }
  .tabs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  /* Pill tab (DESIGN §8.4): index + label, l1 */
  .tab { display: inline-flex; align-items: center; gap: 12px; height: 36px; padding: 0 16px; border-radius: var(--radius-pill); background: var(--bg-muted); color: var(--text); font: 600 12px/1.4 var(--font-mono); text-transform: uppercase; white-space: nowrap; transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out); }
  .tab .n { color: var(--text-2); font-variant-numeric: tabular-nums; }
  .tab[aria-current] { background: var(--neutral-0); color: var(--neutral-950); }
  .tab[aria-current] .n { color: var(--neutral-500); }
  .tab:active { transform: scale(.97); }
  /* Stuck: same black strip as the site header, tighter, one line under the whole nav stack */
  .tabbar.stuck { padding-block: 0 12px; box-shadow: inset 0 -1px 0 var(--line); }
  @media (hover: hover) and (pointer: fine) {
    .tab:not([aria-current]):hover { background: var(--neutral-800); }
  }
  @media (max-width: 699px) { .tabbar { padding-block: 0 16px; } }
</style>
