---
// Running line of every author: photo + name, each linking to their page. Loops forever, edges fade out through a mask.
// The list is rendered twice and slid by half its width, so the loop has no seam; the copy is hidden from screen readers and tab order.
import { getCollection } from 'astro:content';
interface Props { class?: string }
const authors = (await getCollection('authors')).sort((a, b) => a.data.order - b.data.order);
const initials = (name: string) => name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<div class:list={['by', Astro.props.class]}>
<p class="lbl by-k" id="by-k">Submitted &amp; reviewed by</p>
<div class="marquee" aria-labelledby="by-k">
  <div class="track">
    {[false, true].map((copy) => (
      <ul class="row" aria-hidden={copy ? 'true' : undefined}>
        {authors.map(({ id, data }) => (
          <li>
            <a class="who lbl" href={`/authors/${id}`} tabindex={copy ? -1 : undefined}>
              <span class="av" aria-hidden="true">{data.photo ? <img src={data.photo} alt="" loading="lazy" /> : initials(data.name)}</span>
              {data.name}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
</div>

<style>
  .by { display: grid; gap: 16px; width: 100%; min-width: 0; }
  .by-k { color: var(--text-2); }
  .marquee { width: 100%; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent); }
  .track { display: flex; width: max-content; animation: marquee 60s linear infinite; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  .row { display: flex; gap: 24px; padding-right: 24px; }
  .who { display: inline-flex; align-items: center; gap: 10px; color: var(--text-2); white-space: nowrap; transition: color var(--t-fast) var(--ease-out); }
  .av { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: var(--bg-muted); box-shadow: inset 0 0 0 1px var(--line-card); color: var(--text-2); font: 600 11px/1 var(--font-mono); }
  .av img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) { .who:hover { color: var(--text); } }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } .marquee { overflow-x: auto; } }
</style>
