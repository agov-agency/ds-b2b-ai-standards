---
// Rule card (Figma 1000:29373): the area icon on the area's pastel cover at the left, then a black rule-number chip and
// the category chip, the title and its one-line why (each one line, ellipsed), and counts of the scenarios and skills that use it.
// Lists lay these out as a grid (two up on wide pages, one up in content columns).
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { T } from '../site';
import { area } from '../areas';
import ItemIcon from './ItemIcon.astro';
interface Props { rule: CollectionEntry<'rules'> }
const { id, data } = Astro.props.rule;
const uses = (e: { data: { rules: { id: string }[] } }) => e.data.rules.some((r) => r.id === id);
const nSc = (await getCollection('scenarios', uses)).length;
const nSk = (await getCollection('skills', uses)).length;
const work = [
  nSc && { type: 'scenario', text: `${nSc} ${(nSc === 1 ? T.scenario : T.scenarios).toLowerCase()}` },
  nSk && { type: 'skill', text: `${nSk} ${(nSk === 1 ? T.skill : T.skills).toLowerCase()}` },
].filter((w) => !!w);
const cover = area(data.area).cover; // a rule's colour is its category's
---
<a data-type="rule" class="rcard" href={`/rules/${id}`} style={`--cover: var(--pastel-${cover}); --cover-450: var(--pastel-${cover}-450)`}>
  <span class="ico"><ItemIcon data={data} class="pic" /></span>
  <span class="main">
    <span class="kick"><span class="chip dark">{T.rule} {String(data.number).padStart(2, '0')}</span><span class="chip area">{area(data.area).title}</span></span>
    <span class="copy">
      <span class="t-h6 title">{data.title}</span>
      <span class="t-p2 body why">{data.why}</span>
    </span>
    {work.length > 0 && <span class="work">{work.map((w) => <span class="chip out" data-type={w.type}>{w.text}</span>)}</span>}
  </span>
</a>

<style>
  .rcard { display: grid; grid-template-columns: 158px minmax(0, 1fr); height: 100%; border-radius: var(--radius-4); overflow: hidden; background: var(--neutral-0); box-shadow: inset 0 0 0 1px var(--line-card); transition: background-color var(--t-fast) var(--ease-out); }
  /* Cover column: the area's pastel, the icon centred on it at the skill card's 80px */
  .ico { display: grid; place-items: center; background: var(--cover); }
  .ico :global(.pic) { width: 126px; height: 104px; }
  .ico :global(.pic > *) { transition: transform 300ms var(--ease-out); }
  .main { display: grid; gap: 16px; align-content: center; min-width: 0; padding: 24px; }
  .kick { display: flex; flex-wrap: wrap; gap: 4px; }
  .copy { display: grid; gap: 4px; }
  .title, .why { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .work { display: flex; flex-wrap: wrap; gap: 6px; }
  .work .chip::before { content: ''; width: 6px; height: 6px; background: var(--accent); flex: none; }
  @media (hover: hover) and (pointer: fine) {
    /* Hovers like skill cards: the card takes the cover's pastel, the category chip goes black */
    .rcard:hover { background: var(--cover); }
    .area { transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out); }
    .rcard:hover .area { background: var(--neutral-950); color: var(--neutral-0); }
    .rcard:hover .ico :global(.pic > *) { transform: translateY(-2px); }
  }
  @media (max-width: 699px) {
    .rcard { grid-template-columns: 96px minmax(0, 1fr); }
    .ico :global(.pic) { width: 76px; height: 64px; }
    .main { padding: 16px; }
    .title { white-space: normal; }
  }
</style>
