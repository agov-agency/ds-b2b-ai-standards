---
// Site-level header on every page (black, never flips to white; transparent at the very top over black): logo, Directory, Authors, actions. The library tab bar is a second level, hubs only.
import { SITE_NAV, T, CONTRIBUTE_URL } from '../site';
const path = Astro.url.pathname;
---
<header class="site-header surface-black" data-site-header>
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="The B2B AI Standard for LinkedIn Ads, home">
      <img src="/design-system/brand/logo-b2b.svg" alt="" width="358" height="40">
    </a>
    <nav class="nav" aria-label="Site">
      {SITE_NAV.map((n) => {
        const here = n.match.some((m) => path.startsWith(m));
        // The badge shows everywhere except inside its own section
        return <a href={n.href} aria-current={here ? 'page' : undefined}>{n.label}{n.badge && !here && <span class="new">{n.badge}</span>}</a>;
      })}
    </nav>
    <div class="end">
      <a class="btn ghost sm submit" href={CONTRIBUTE_URL}>Submit your work</a>
      <a class="btn filled sm" href="/scenarios">Try <span class="long">your first</span><span class="short">a</span> {T.scenario.toLowerCase()}</a>
    </div>
  </div>
</header>
<div class="site-spacer" aria-hidden="true"></div>

<script>
  // At the very top and over a black section: transparent, no line. Fill and line appear once the page scrolls; over a light top (detail pages) it stays filled (DESIGN.md §8.16)
  const h = document.querySelector<HTMLElement>('[data-site-header]');
  const sync = () => {
    if (!h) return;
    const under = document.elementsFromPoint(innerWidth / 2, h.offsetHeight + 1).find((el) => !h.contains(el));
    h.classList.toggle('at-top', scrollY <= 0 && !!under?.closest('.surface-black'));
  };
  addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', sync);
  sync();
</script>

<style>
  /* Always fixed and black (never flips to white); transparent with no line only at the very top. The spacer keeps its place in the flow */
  .site-header { position: fixed; inset: 0 0 auto; z-index: var(--z-sticky); background: var(--bg); color: var(--text); box-shadow: inset 0 -1px 0 var(--line); transition: background-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out); }
  .site-header.tabs-stuck, .site-header.at-top { box-shadow: none; }
  .site-header.at-top { background-color: transparent; }
  .site-spacer { height: var(--site-bar); }
  .bar { display: flex; align-items: center; gap: 32px; height: var(--site-bar); }
  .logo { display: flex; margin-right: auto; }
  .logo img { display: block; height: 40px; width: auto; }
  .nav { display: flex; gap: 24px; }
  .nav a { font: 600 12px/1.4 var(--font-mono); text-transform: uppercase; color: var(--text-2); transition: color var(--t-fast) ease; }
  .nav a[aria-current] { color: var(--text); }
  .nav a { display: inline-flex; align-items: center; gap: 6px; }
  .new { padding: 1px 5px; border-radius: var(--radius-2); background: var(--secondary-300); color: var(--neutral-950); font: 600 10px/1.4 var(--font-mono); animation: new-in 250ms var(--ease-out) both; }
  @keyframes new-in { from { opacity: 0; transform: scale(.9); } }
  @media (prefers-reduced-motion: reduce) { .new { animation: none; } }
  .end { display: flex; gap: 8px; align-items: center; margin-left: auto; }
  @media (hover: hover) and (pointer: fine) { .nav a:hover { color: var(--text); } }
    .short { display: none; }
  /* Phones: mark + site nav only; the wordmark's second line is unreadable below ~40px tall, and the "Try" button would push the bar past 375px */
  @media (max-width: 699px) { .end { display: none; } .logo img { width: 32px; height: 32px; object-fit: cover; object-position: left; } .nav { gap: 16px; } .short { display: inline; } .bar { flex-wrap: nowrap; gap: 16px; } }
</style>
