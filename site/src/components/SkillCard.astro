---
// Skill card, Notion style (brief): ~80px icon with no background, area chip above the title (same grey chip as scenario cards), title, short description, author.
// Ready skills link to their page; coming-soon skills link to the rule they will check and are greyed like soon scenario cards.
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { area } from '../areas';
import ItemArt from './ItemArt.astro';
import { icon } from '../icons';
import Byline from './Byline.astro';
interface Props { skill: CollectionEntry<'skills'> }
const { id, data } = Astro.props.skill;
const author = data.author ? await getEntry(data.author) : undefined;
const next = data.status === 'next';
const href = next && data.rules[0] ? `/rules/${data.rules[0].id}` : `/skills/${id}`;
---
<a data-type="skill" class:list={['kcard', { next }]} href={href} style={`--cover: var(--pastel-${area(data.area).cover}); --cover-450: var(--pastel-${area(data.area).cover}-450)`}>
  <span class="cover"><ItemArt data={data} still lazy><span class="ico" aria-hidden="true" set:html={icon(data.icon ?? area(data.area).icon)} /></ItemArt></span>
  <p class="chips"><span class="chip">{area(data.area).title}</span></p>
  <h3 class="t-h6">{data.title}</h3>
  <p class="t-p2 body desc">{data.description}</p>
  <p class="foot">
    {author && !next && <Byline author={author} />}
    {next && <span class="chip out soon-chip">Coming next</span>}
  </p>
</a>

<style>
  .kcard { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 8px; height: 100%; padding: 24px; border: 1px solid var(--line-card); border-radius: var(--radius-4); overflow: hidden; background: var(--neutral-0); transition: background-color var(--t-fast) var(--ease-out); }
  /* Cover: pastel band across the top, icon on it as before. A real border (not an inset shadow) outlines the whole card, cover included: the cover's fill would paint over a shadow */
  .cover { display: block; margin: -24px -24px 16px; padding: 16px 24px 24px 16px; background: var(--cover); }
  .ico { display: block; width: 80px; height: 80px; }
  .ico :global(.hl) { --hairline-hi: var(--cover-450); width: 100%; height: 100%; transition: transform 300ms var(--ease-out); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 4px; }
  .desc { align-self: start; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-top: 16px; }
  .soon-chip { color: var(--neutral-500); }
  .next .cover { filter: grayscale(1); opacity: .6; }
  .next h3, .next .desc { color: var(--text-2); }
  @media (hover: hover) and (pointer: fine) {
    /* Ready skills hover like scenario cards: the whole card takes the cover's pastel, chips firm up to black. Coming-soon cards don't react */
    .kcard:not(.next):hover { background: var(--cover); }
    .chip { transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out); }
    .kcard:not(.next):hover .chip:not(.out) { background: var(--neutral-950); color: var(--neutral-0); }
    .kcard:not(.next):hover .ico :global(.hl) { transform: translateY(-2px); }
  }
</style>
