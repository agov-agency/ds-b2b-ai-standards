---
// Social post builder: an internal, unlinked page (no nav, noindex) for the launch & distribution kit. Templates are
// filled from the CMS (scenarios, skills, rules, quotes, authors) and from the launch copy; every post is editable and
// exports as 2x PNG, or MP4 when its figure or wave moves. Posts reuse the site's art (src/art), wave, logo and tokens.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IsoArt from '../components/IsoArt.astro';
import { ART_POOLS, pieces } from '../art';
import { alts } from '../art/alt';
import { ICON_POOLS } from '../icons';
import { area, AREA_LIST } from '../areas';
import { QUOTES } from '../site';

const [scenarios, skills, rules, authors] = await Promise.all([getCollection('scenarios'), getCollection('skills'), getCollection('rules'), getCollection('authors')]);
const by = <T extends { data: { order?: number } }>(a: T, b: T) => (a.data.order ?? 99) - (b.data.order ?? 99);
const ref = (r: unknown) => (typeof r === 'string' ? r : (r as { id?: string } | undefined)?.id);
const icon = (name: string | undefined, pool: string[], i: number) => (name && pieces[`i-${name}`] ? `i-${name}` : `i-${pool[i % pool.length]}`);

const data = {
  authors: authors.sort(by).map(({ id, data: a }) => ({ id, name: a.name, role: a.role ?? '', company: a.company ?? '', photo: a.photo ?? '' })),
  scenarios: scenarios.sort(by).map(({ id, data: s }) => ({
    id, title: s.title, description: s.description, cadence: s.cadence, author: ref(s.author), status: s.status,
    cover: s.cover ?? area(s.category).cover, category: area(s.category).title, connectors: s.connectors,
    art: s.art && pieces[s.art.piece] ? s.art : undefined, steps: s.page.steps.map((x) => x.title),
  })),
  skills: skills.sort(by).map(({ id, data: s }, i) => ({
    id, title: s.title, description: s.description, author: ref(s.author), status: s.status, cover: s.cover ?? area(s.area).cover,
    category: area(s.area).title, connectors: s.connectors, icon: icon(s.icon, ICON_POOLS.skill, i), changes: s.changes ?? '',
  })),
  rules: rules.sort((a, b) => a.data.number - b.data.number).map(({ id, data: r }, i) => ({
    id, number: r.number, title: r.title, why: r.why, author: ref(r.author), cover: r.cover ?? area(r.area).cover, category: area(r.area).title,
    icon: icon(r.icon, ICON_POOLS.rule, i), advises: r.page.advises?.text ?? '', adds: r.page.adds ?? '',
    voices: r.page.voices.map((v) => ({ name: v.name, author: ref(v.author), company: v.company ?? '', quote: v.quote })),
  })),
  quotes: QUOTES,
  categories: AREA_LIST.map((c) => c.title),
};

// Art the posts can use, grouped as the CMS pools are; alternatives are the takes not yet picked
const figureNames = Object.keys(pieces).filter((n) => !n.startsWith('i-') && !n.startsWith('x-'));
const artGroups = [
  { label: 'Scenario figures', items: ART_POOLS.scenario },
  { label: 'Hub and CTA figures', items: figureNames.filter((n) => !ART_POOLS.scenario.includes(n)) },
  { label: 'Skill icons', items: ICON_POOLS.skill.map((n) => `i-${n}`).filter((n) => pieces[n]) },
  { label: 'Rule icons', items: ICON_POOLS.rule.map((n) => `i-${n}`).filter((n) => pieces[n]) },
  { label: 'Alternatives', items: [...Object.keys(pieces).filter((n) => n.startsWith('x-')), ...Object.keys(alts).map((n) => `alt:${n}`)] },
];
const pretty = (n: string) => n.replace(/^(i-|x-|alt:)/, '').replace(/[-_]/g, ' ');
const logos = import.meta.glob('../../../design-system/logos/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const logoSet = Object.fromEntries(Object.entries(logos).map(([p, svg]) => [p.split('/').pop()!.replace('.svg', ''), svg]));

const FORMATS = [['square', 'Square 1080'], ['portrait', '4:5 1080×1350'], ['story', '9:16'], ['wide', 'Email 1200×628'], ['header', 'Header 1200×480'], ['block', 'Block 1200×240'], ['cover', 'Cover 1920×1080']];
const PASTELS = Array.from({ length: 20 }, (_, i) => i + 1);
const seg = (k: string, opts: string[][]) => ({ k, opts });
---
<Base title="Post builder · The B2B AI Standard" description="Internal tool">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script type="application/json" id="pb-data" set:html={JSON.stringify({ ...data, logos: logoSet })} />

  <header class="pb-bar surface-black">
    <img src="/design-system/brand/logo-b2b.svg" alt="The B2B AI Standard for LinkedIn Ads" height="28" />
    <p class="lbl">Post builder</p>
    <div class="tab-switch" role="tablist" aria-label="View">
      <button role="tab" aria-selected="true" data-view="templates">Templates</button>
      <button role="tab" aria-selected="false" data-view="editor">Editor</button>
    </div>
  </header>

  <main id="main" class="pb">
    <section class="pb-view pb-gallery" data-pane="templates" aria-label="Templates">
      <div class="pb-intro">
        <h1 class="headline t-h4">Every post the launch kit asks for. <span class="tone-2">Pick one, change anything, export 2x PNG or MP4</span></h1>
        <p class="t-p2 body">Cards are filled from the CMS: edit an item in Studio, publish, and its card here follows after the rebuild. Formats from the distribution kit: 1080 square, 4:5, email 1200, newsletter header 1200×480, block 1200×240, cover 1920×1080.</p>
      </div>
      <div class="pb-groups" data-groups></div>
    </section>

    <section class="pb-view pb-editor" data-pane="editor" aria-label="Editor" hidden>
      <form class="pb-panel" data-panel onsubmit="return false">
        <fieldset>
          <legend class="marker">Template</legend>
          <p class="t-p2" data-tname>Blank</p>
          <div class="row"><button type="button" class="btn outlined xs" data-act="templates">All templates</button><button type="button" class="btn ghost xs" data-act="reset">Reset</button></div>
        </fieldset>

        <fieldset>
          <legend class="marker">Format and layout</legend>
          <div class="tab-switch" data-seg="format">{FORMATS.map(([v, l]) => <button type="button" role="tab" data-v={v}>{l}</button>)}</div>
          <p class="lbl-2">Layout</p>
          <div class="tab-switch" data-seg="layout"><button type="button" role="tab" data-v="a" data-wide="Text left">Text first</button><button type="button" role="tab" data-v="b" data-wide="Art left">Art first</button><button type="button" role="tab" data-v="over">Text over art</button><button type="button" role="tab" data-v="none">Text only</button></div>
          <p class="lbl-2">Text sits</p>
          <div class="tab-switch" data-seg="vpos"><button type="button" role="tab" data-v="start">Top</button><button type="button" role="tab" data-v="center">Middle</button><button type="button" role="tab" data-v="end">Bottom</button></div>
          <div class="tab-switch" data-seg="align"><button type="button" role="tab" data-v="left">Left</button><button type="button" role="tab" data-v="center">Centred</button></div>
        </fieldset>

        <fieldset>
          <legend class="marker">Colour</legend>
          <p class="lbl-2">Background</p>
          <div class="sw" data-swatch="bg">
            <button type="button" data-v="black" style="--c: var(--neutral-1000)" aria-label="Black"></button>
            <button type="button" data-v="white" style="--c: var(--neutral-0)" aria-label="White"></button>
            {PASTELS.map((n) => <button type="button" data-v={`pastel-${n}`} style={`--c: var(--pastel-${n})`} aria-label={`Pastel ${n}`}></button>)}
            <label class="pick" aria-label="Custom background"><input type="color" data-k="bgCustom" /></label>
          </div>
          <p class="lbl-2">Accent (art, quote mark, band)</p>
          <div class="sw" data-swatch="hue">
            <button type="button" data-v="auto" class="auto" aria-label="Auto: the background's or the item's hue">A</button>
            <button type="button" data-v="primary" style="--c: var(--primary-450)" aria-label="Primary blue"></button>
            {PASTELS.map((n) => <button type="button" data-v={String(n)} style={`--c: var(--pastel-${n}-450)`} aria-label={`Hue ${n}`}></button>)}
            <label class="pick" aria-label="Custom accent"><input type="color" data-k="hueCustom" /></label>
          </div>
          <label class="ck"><input type="checkbox" data-k="lines" /> Edge lines</label>
          <label class="ck"><input type="checkbox" data-k="pattern" /> Dot pattern</label>
          <label class="ck" data-if="layout=over"><input type="checkbox" data-k="scrim" /> Fade art under the text</label>
        </fieldset>

        <fieldset>
          <legend class="marker">Top</legend>
          <label class="ck"><input type="checkbox" data-k="logo" /> Logo</label>
          <div data-if="logo=true">
            <div class="tab-switch" data-seg="logoKind"><button type="button" role="tab" data-v="full">Full</button><button type="button" role="tab" data-v="mark">Mark</button></div>
            <div class="tab-switch" data-seg="logoPos"><button type="button" role="tab" data-v="left">Left</button><button type="button" role="tab" data-v="right">Right</button></div>
            <label class="fld">Logo height <input type="range" min="20" max="160" step="2" data-k="logoH" /></label>
          </div>
          <label class="ck"><input type="checkbox" data-k="label" /> Label</label>
          <label class="fld" data-if="label=true"><input type="text" data-k="labelText" placeholder="Rule 08" /></label>
        </fieldset>

        <fieldset>
          <legend class="marker">Text</legend>
          <label class="ck"><input type="checkbox" data-k="chips" /> Chips</label>
          <label class="fld" data-if="chips=true"><input type="text" data-k="chipsText" placeholder="Comma, separated" /></label>
          <label class="ck"><input type="checkbox" data-k="qmark" /> Quote mark</label>
          <label class="fld">Headline <textarea rows="3" data-k="headline"></textarea></label>
          <label class="fld">Grey part <textarea rows="2" data-k="context"></textarea></label>
          <div class="tab-switch" data-seg="hsize"><button type="button" role="tab" data-v="auto">Auto size</button><button type="button" role="tab" data-v="fixed">Fixed size</button></div>
          <label class="fld" data-if="hsize=fixed">Headline size <input type="range" min="20" max="220" step="1" data-k="hpx" /></label>
          <label class="fld" data-if="hsize=auto">Largest auto size <input type="range" min="32" max="220" step="2" data-k="hmax" /></label>
          <label class="ck"><input type="checkbox" data-k="rule" /> Divider under the headline</label>
          <label class="ck"><input type="checkbox" data-k="body" /> Body text</label>
          <label class="fld" data-if="body=true"><textarea rows="3" data-k="bodyText"></textarea></label>
          <label class="ck"><input type="checkbox" data-k="pairs" /> Boxes (default vs Standard, Runs on)</label>
          <label class="fld" data-if="pairs=true">One per line: <code>Label | text</code>, start with * to fill it <textarea rows="3" data-k="pairsText"></textarea></label>
          <label class="ck"><input type="checkbox" data-k="steps" /> Steps strip</label>
          <label class="fld" data-if="steps=true">One step per line <textarea rows="4" data-k="stepsText"></textarea></label>
          <label class="ck"><input type="checkbox" data-k="tools" /> Tools</label>
          <label class="fld" data-if="tools=true"><input type="text" data-k="toolsText" placeholder="Claude, LinkedIn Ads export, CRM export" /></label>
          <label class="ck"><input type="checkbox" data-k="list" /> List</label>
          <label class="fld" data-if="list=true">One per line: <code>Label | text</code> <textarea rows="4" data-k="listText"></textarea></label>
          <label class="ck"><input type="checkbox" data-k="button" /> Button</label>
          <label class="fld" data-if="button=true"><input type="text" data-k="buttonText" /></label>
        </fieldset>

        <fieldset>
          <legend class="marker">Author</legend>
          <label class="fld"><select data-k="author"><option value="">None</option><option value="custom">Someone else…</option>{data.authors.map((a) => <option value={a.id}>{a.name}</option>)}</select></label>
          <div data-if="author!=">
            <div class="tab-switch" data-seg="authorStyle"><button type="button" role="tab" data-v="byline">Byline at the bottom</button><button type="button" role="tab" data-v="card">Card in the text</button></div>
          </div>
          <div data-if="author=custom">
            <label class="fld">Name <input type="text" data-k="aName" /></label>
            <label class="fld">Role, company <input type="text" data-k="aRole" /></label>
            <label class="fld">Photo URL <input type="text" data-k="aPhoto" placeholder="/authors/justin-rowe.jpg" /></label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="marker">Bottom</legend>
          <label class="ck"><input type="checkbox" data-k="meta" /> Footer text</label>
          <div data-if="meta=true">
            <label class="fld"><input type="text" data-k="metaText" /></label>
            <div class="tab-switch" data-seg="foot"><button type="button" role="tab" data-v="plain">Plain</button><button type="button" role="tab" data-v="band">Colour band</button></div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="marker">Art</legend>
          <label class="fld"><select data-k="art.id">
            <option value="none">None</option>
            <option value="wave">Wave</option>
            <option value="photo">Photo</option>
            {artGroups.map((g) => <optgroup label={g.label}>{g.items.map((n) => <option value={n}>{pretty(n)}</option>)}</optgroup>)}
          </select></label>
          <div data-if="art.id!=none">
            <div class="tab-switch" data-seg="art.frame"><button type="button" role="tab" data-v="bleed">To the edge</button><button type="button" role="tab" data-v="panel">On a panel</button><button type="button" role="tab" data-v="free">Free</button></div>
            <label class="fld">Zoom <input type="range" min=".4" max="3" step=".02" data-k="art.zoom" /></label>
            <label class="fld">Move ↔ <input type="range" min="-60" max="60" step="1" data-k="art.x" /></label>
            <label class="fld">Move ↕ <input type="range" min="-60" max="60" step="1" data-k="art.y" /></label>
          </div>
          <div data-if="art.id!=wave">
            <label class="fld" data-if="art.id!=photo">Moment (the still frame, and where the video starts) <input type="range" min="0" max="12" step=".05" data-k="art.t" /></label>
            <label class="ck" data-if="art.id!=photo"><input type="checkbox" data-k="art.mono" /> Grey, accent only on the live part</label>
          </div>
          <label class="ck" data-if="art.id!=photo"><input type="checkbox" data-k="art.animate" /> Animate (exports as MP4)</label>
          <label class="fld" data-if="art.id=photo">Photo URL (empty = the author's) <input type="text" data-k="art.photo" /></label>
          <div data-if="art.id=wave" class="wave-set">
            <div class="row">
              <button type="button" class="btn outlined xs" data-wave-preset="brand">Brand</button>
              <button type="button" class="btn outlined xs" data-wave-preset="cta">CTA blue</button>
              <button type="button" class="btn outlined xs" data-wave-preset="mono">Grey</button>
            </div>
            <div class="row colors">
              <label class="pick" aria-label="Wave colour 1"><input type="color" data-k="wave.c1" /></label>
              <label class="pick" aria-label="Wave colour 2"><input type="color" data-k="wave.c2" /></label>
              <label class="pick" aria-label="Wave colour 3"><input type="color" data-k="wave.c3" /></label>
              <label class="pick" aria-label="Wave ground"><input type="color" data-k="wave.ground" /></label>
              <span class="lbl-2">Ribbon · fold · ribbon · ground</span>
            </div>
            <label class="fld">Ribbon size <input type="range" min=".4" max="3" step=".02" data-k="wave.k" /></label>
            <label class="fld">Moment <input type="range" min="0" max="60" step=".1" data-k="wave.time" /></label>
          </div>
        </fieldset>
      </form>

      <div class="pb-stage">
        <div class="pb-actions">
          <p class="lbl" data-size></p>
          <button type="button" class="btn filled sm" data-act="png">PNG 2x</button>
          <button type="button" class="btn brand sm" data-act="mp4">MP4</button>
          <button type="button" class="btn outlined sm" data-act="link">Copy link</button>
        </div>
        <div class="pb-progress" data-progress hidden><span></span></div>
        <div class="pb-fit" data-fit><div class="pb-scale" data-scale></div></div>
      </div>
    </section>
  </main>

  <!-- Prototypes: the IsoArt markup (and its scoped styles) the client clones for every figure it draws -->
  <div class="pb-protos" aria-hidden="true">
    <IsoArt name="sorter" still class="pb-proto-l" />
    <IsoArt name="sorter" dark still class="pb-proto-d" />
  </div>
  <p class="toast" data-toast role="status"></p>
</Base>

<script>
  import { boot } from '../builder';
  boot();
</script>

<style is:global>
  /* Builder chrome: the site's tab switch, buttons, markers and underline fields; posts are styled below */
  .pb-bar { position: sticky; top: 0; z-index: var(--z-sticky); display: flex; align-items: center; gap: 24px; padding: 14px 24px; box-shadow: inset 0 -1px 0 var(--line); }
  .pb-bar img { height: 28px; width: auto; }
  .pb-bar .lbl { margin-right: auto; color: var(--text-2); }
  .pb-bar .tab-switch > [role=tab] { color: var(--text-2); }
  .pb-view { animation: pb-in var(--t-base) var(--ease-out); }
  .pb-view[hidden] { display: none; }
  @keyframes pb-in { from { opacity: 0; transform: translateY(6px); } }

  .pb-gallery { padding: 48px 24px 120px; display: grid; gap: 48px; }
  .pb-intro { display: grid; gap: 12px; max-width: 760px; }
  .pb-groups { display: grid; gap: 56px; }
  .pb-group { display: grid; gap: 16px; }
  .pb-group > header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .pb-group > header .t-p2 { color: var(--text-2); }
  .pb-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .pb-card { display: grid; gap: 8px; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit; }
  .pb-thumb { position: relative; display: grid; place-items: center; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-4); background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); transition: box-shadow var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
  .pb-thumb > div { position: absolute; left: 50%; top: 50%; transform-origin: center; }
  .pb-card .t-p3 { color: var(--text-2); }
  .pb-card:active .pb-thumb { transform: scale(.98); }
  @media (hover: hover) and (pointer: fine) { .pb-card:hover .pb-thumb { box-shadow: inset 0 0 0 1px var(--text), var(--shadow-lift); } }

  .pb-editor { display: grid; grid-template-columns: 380px minmax(0, 1fr); min-height: calc(100vh - 57px); }
  .pb-panel { height: calc(100vh - 57px); overflow-y: auto; overscroll-behavior: contain; position: sticky; top: 57px; padding: 24px; display: grid; align-content: start; gap: 0; box-shadow: inset -1px 0 0 var(--line); }
  .pb-panel fieldset { display: grid; gap: 12px; margin: 0; padding: 20px 0; border: 0; border-bottom: 1px solid var(--line); min-width: 0; }
  .pb-panel legend { float: left; padding: 0; margin-bottom: 4px; }
  .pb-panel legend + * { clear: both; }
  .pb-panel [data-if] { display: grid; gap: 12px; }
  .pb-panel [hidden] { display: none; }
  .pb-panel .tab-switch > [role=tab] { padding: 6px 10px; font-size: 11px; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ck { display: flex; align-items: center; gap: 8px; font: 500 14px/1.4 var(--font-sans); letter-spacing: -.03em; cursor: pointer; min-height: 28px; }
  .ck input { width: 16px; height: 16px; margin: 0; accent-color: var(--neutral-950); }
  .fld { display: grid; gap: 4px; font: 600 10px/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0; color: var(--text-body); }
  .fld code { font: inherit; text-transform: none; color: var(--text); }
  .fld :is(input[type=text], textarea, select) { width: 100%; padding: 6px 0 8px; border: 0; border-bottom: 1px solid var(--line-field); border-radius: 0; background: none; color: var(--text); font: 500 14px/1.4 var(--font-sans); letter-spacing: -.03em; text-transform: none; resize: vertical; transition: border-color var(--t-fast) ease; }
  .fld :is(input[type=text], textarea, select):is(:hover, :focus) { border-color: var(--neutral-950); outline: none; }
  .fld input[type=range] { width: 100%; accent-color: var(--neutral-950); }
  .sw { display: flex; flex-wrap: wrap; gap: 6px; }
  .sw > button, .pick { width: 24px; height: 24px; padding: 0; border: 0; border-radius: var(--radius-2); background: var(--c); box-shadow: inset 0 0 0 1px var(--line-card); cursor: pointer; transition: box-shadow var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
  .sw > button.auto { font: 600 10px/1 var(--font-mono); color: var(--text-body); background: var(--bg-muted); }
  .sw > button[aria-pressed=true] { box-shadow: 0 0 0 2px var(--neutral-0), 0 0 0 3px var(--neutral-950); }
  .sw > button:active { transform: scale(.92); }
  .pick { position: relative; overflow: hidden; background: conic-gradient(from 90deg, #ff6a4b, #ffb900, #00ac6f, #55c0f9, #3875f6, #7c0f99, #ff6a4b); }
  .pick input { position: absolute; inset: -8px; width: 40px; height: 40px; opacity: 0; cursor: pointer; }
  .wave-set .colors .pick { background: var(--c, #000); }

  .pb-stage { display: grid; grid-template-rows: auto auto 1fr; gap: 16px; padding: 24px; min-width: 0; }
  .pb-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .pb-actions .lbl { margin-right: auto; color: var(--text-2); }
  .pb-progress { height: 2px; background: var(--line); overflow: hidden; }
  .pb-progress > span { display: block; height: 100%; background: var(--neutral-950); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 120ms linear; }
  .pb-fit { position: relative; display: grid; place-items: center; min-height: 0; height: calc(100vh - 57px - 140px); border-radius: var(--radius-4); background: var(--bg-subtle); background-image: radial-gradient(circle, #0b0c0d26 1px, transparent 1.5px); background-size: 12px 12px; overflow: hidden; }
  .pb-scale { position: absolute; left: 50%; top: 50%; transform-origin: center; box-shadow: var(--shadow-pop); }
  .pb-protos { position: absolute; width: 0; height: 0; overflow: hidden; visibility: hidden; pointer-events: none; }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }
  @media (max-width: 899px) {
    .pb-editor { grid-template-columns: 1fr; }
    .pb-panel { position: static; height: auto; box-shadow: none; order: 2; }
    .pb-fit { height: 70vh; }
  }
  @media (prefers-reduced-motion: reduce) { .pb-view { animation: none; } }

  /* ---------- Post: drawn at its export size; --s scales spacing and small type with the format ---------- */
