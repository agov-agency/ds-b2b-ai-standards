---
// Social post builder: an internal, unlinked page (no nav, noindex) for the launch & distribution kit. Templates are
// filled from the CMS (scenarios, skills, rules, quotes, authors) and from the launch copy; every post is editable and
// exports as 2x PNG, or MP4 when its figure or wave moves. Posts reuse the site's art (src/art), wave, logo and tokens.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IsoArt from '../components/IsoArt.astro';
import { ART_POOLS, pieces } from '../art';
import { figures } from '../art/figures';
import { ALT_RULES } from '../art/alt-rules';
import { ALT_SKILLS_A } from '../art/alt-skills-1';
import { ALT_SKILLS_B } from '../art/alt-skills-2';
import { alts } from '../art/alt';
import { ICON_POOLS } from '../icons';
import { area, AREA_LIST } from '../areas';
import { QUOTES } from '../site';

const [scenarios, skills, rules, authors] = await Promise.all([getCollection('scenarios'), getCollection('skills'), getCollection('rules'), getCollection('authors')]);
const by = <T extends { data: { order?: number } }>(a: T, b: T) => (a.data.order ?? 99) - (b.data.order ?? 99);
const ref = (r: unknown) => (typeof r === 'string' ? r : (r as { id?: string } | undefined)?.id);
const icon = (name: string | undefined, pool: string[], i: number) => (name && pieces[`i-${name}`] ? `i-${name}` : `i-${pool[i % pool.length]}`);

const data = {
  authors: authors.sort(by).map(({ id, data: a }) => ({ id, name: a.name, role: a.role ?? '', company: a.company ?? '', photo: a.photo ?? '' })),
  scenarios: scenarios.sort(by).map(({ id, data: s }) => ({
    id, title: s.title, description: s.description, cadence: s.cadence, author: ref(s.author), status: s.status,
    cover: s.cover ?? area(s.category).cover, category: area(s.category).title, connectors: s.connectors,
    art: s.art && pieces[s.art.piece] ? s.art : undefined, steps: s.page.steps.map((x) => x.title),
  })),
  skills: skills.sort(by).map(({ id, data: s }, i) => ({
    id, title: s.title, description: s.description, author: ref(s.author), status: s.status, cover: s.cover ?? area(s.area).cover,
    category: area(s.area).title, connectors: s.connectors, icon: icon(s.icon, ICON_POOLS.skill, i), changes: s.changes ?? '',
  })),
  rules: rules.sort((a, b) => a.data.number - b.data.number).map(({ id, data: r }, i) => ({
    id, number: r.number, title: r.title, why: r.why, author: ref(r.author), cover: r.cover ?? area(r.area).cover, category: area(r.area).title,
    icon: icon(r.icon, ICON_POOLS.rule, i), advises: r.page.advises?.text ?? '', adds: r.page.adds ?? '',
    voices: r.page.voices.map((v) => ({ name: v.name, author: ref(v.author), company: v.company ?? '', quote: v.quote })),
  })),
  quotes: QUOTES,
  categories: AREA_LIST.map((c) => c.title),
};

// Art the posts can use, by what it belongs to: each category has the pieces in use, then the alternatives not yet picked
const ALT_X = { rule: Object.keys(ALT_RULES), skill: [...Object.keys(ALT_SKILLS_A), ...Object.keys(ALT_SKILLS_B)] };
const altsOf = (test: (of: string) => boolean) => Object.entries(alts).filter(([, a]) => test(a.of)).map(([n]) => `alt:${n}`);
const hub = Object.keys(figures).filter((n) => !ART_POOLS.scenario.includes(n));
const artCats = [
  { id: 'scenario', label: 'Scenarios', items: ART_POOLS.scenario, alts: altsOf((o) => ART_POOLS.scenario.includes(o)) },
  { id: 'skill', label: 'Skills', items: ICON_POOLS.skill.map((n) => `i-${n}`).filter((n) => pieces[n]), alts: [...ALT_X.skill.map((n) => `x-${n}`), ...altsOf((o) => ICON_POOLS.skill.includes(o.replace(/^i-/, '')))] },
  { id: 'rule', label: 'Rules', items: ICON_POOLS.rule.map((n) => `i-${n}`).filter((n) => pieces[n]), alts: [...ALT_X.rule.map((n) => `x-${n}`), ...altsOf((o) => ICON_POOLS.rule.includes(o.replace(/^i-/, '')))] },
  { id: 'hub', label: 'Site', items: hub, alts: altsOf((o) => hub.includes(o)) },
];
const connectorNames = [...new Set([...scenarios, ...skills].flatMap((x) => x.data.connectors))].sort();
const pretty = (n: string) => n.replace(/^(i-|x-|alt:)/, '').replace(/[-_]/g, ' ');
const logos = import.meta.glob('../../../design-system/logos/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const logoSet = Object.fromEntries(Object.entries(logos).map(([p, svg]) => [p.split('/').pop()!.replace('.svg', ''), svg]));

const FORMATS = [['square', '1:1', 1080, 1080], ['portrait', '4:5', 1080, 1350], ['story', '9:16', 1080, 1920], ['wide', 'Landscape', 1200, 628], ['header', 'Header', 1200, 480], ['block', 'Block', 1200, 240], ['cover', '16:9', 1920, 1080]] as const;
const PASTELS = Array.from({ length: 20 }, (_, i) => i + 1);
---
<Base title="Post builder · The B2B AI Standard" description="Internal tool">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script type="application/json" id="pb-data" set:html={JSON.stringify({ ...data, logos: logoSet, connectorNames })} />

  <header class="pb-bar surface-black">
    <img src="/design-system/brand/logo-b2b.svg" alt="The B2B AI Standard for LinkedIn Ads" height="28" />
    <p class="lbl">Post builder</p>
    <div class="seg" role="tablist" aria-label="View">
      <button type="button" role="tab" aria-selected="true" data-view="templates">Templates</button>
      <button type="button" role="tab" aria-selected="false" data-view="editor">Editor</button>
    </div>
  </header>

  <main id="main" class="pb">
    <section class="pb-view pb-gallery" data-pane="templates" aria-label="Templates">
      <div class="pb-intro">
        <h1 class="headline t-h4">Every post the launch kit asks for. <span class="tone-2">Pick one, change anything, export 2x PNG or MP4</span></h1>
        <p class="t-p2 body">Cards are filled from the CMS: edit an item in Studio, publish, and its card here follows after the rebuild. Formats from the distribution kit: 1080 square, 4:5, email 1200, newsletter header 1200×480, block 1200×240, cover 1920×1080.</p>
      </div>
      <div class="pb-groups" data-groups></div>
    </section>

    <section class="pb-view pb-editor" data-pane="editor" aria-label="Editor" hidden>
      <form class="pb-panel" data-panel onsubmit="return false">
        <div class="pb-ptop">
          <p class="lbl-2">Template</p>
          <p class="t-p2" data-tname>Blank</p>
          <div class="row"><button type="button" class="btn outlined xs" data-act="templates">All templates</button><button type="button" class="btn ghost xs" data-act="reset">Reset</button></div>
          <div class="seg" role="tablist" aria-label="Settings">
            <button type="button" role="tab" data-ptab-btn="content" aria-selected="true">Content</button>
            <button type="button" role="tab" data-ptab-btn="layout">Layout</button>
            <button type="button" role="tab" data-ptab-btn="art">Art</button>
            <button type="button" role="tab" data-ptab-btn="colour">Colour</button>
          </div>
        </div>

        <div class="pb-ptab" data-ptab="content">
          <fieldset>
            <legend class="marker">About</legend>
            <label class="fld">The item the post is about <select data-k="about"><option value="">Nothing in particular</option>
              <optgroup label="Scenarios">{data.scenarios.map((x) => <option value={`scenario:${x.id}`}>{x.title}</option>)}</optgroup>
              <optgroup label="Skills">{data.skills.map((x) => <option value={`skill:${x.id}`}>{x.title}</option>)}</optgroup>
              <optgroup label="Rules">{data.rules.map((x) => <option value={`rule:${x.id}`}>{String(x.number).padStart(2, '0')} · {x.title}</option>)}</optgroup>
              <optgroup label="Authors">{data.authors.map((x) => <option value={`author:${x.id}`}>{x.name}</option>)}</optgroup>
            </select></label>
            <p class="hint" data-if="about!=">Picking it sets its colour and illustration; alternatives are under Art.</p>
            <button type="button" class="btn outlined xs" data-act="fill" data-if="about!=">Fill the text from it</button>
          </fieldset>
          <fieldset>
            <legend class="marker">Headline</legend>
            <label class="tg"><span>Label</span><input type="checkbox" role="switch" data-k="label" /></label>
            <label class="fld" data-if="label=true"><input type="text" data-k="labelText" placeholder="Rule 08" /></label>
            <label class="fld">Headline <textarea rows="3" data-k="headline"></textarea></label>
            <label class="fld">Grey part <textarea rows="2" data-k="context"></textarea></label>
            <div class="seg" data-seg="hsize"><button type="button" data-v="auto">Auto size</button><button type="button" data-v="fixed">Fixed size</button></div>
            <label class="fld" data-if="hsize=fixed">Size <input type="range" min="20" max="220" step="1" data-k="hpx" /></label>
            <label class="fld" data-if="hsize=auto">Largest size <input type="range" min="32" max="200" step="2" data-k="hmax" /></label>
          </fieldset>
          <fieldset>
            <legend class="marker">More text</legend>
            <label class="tg"><span>Quote mark</span><input type="checkbox" role="switch" data-k="qmark" /></label>
            <label class="tg"><span>Chips</span><input type="checkbox" role="switch" data-k="chips" /></label>
            <label class="fld" data-if="chips=true"><input type="text" data-k="chipsText" placeholder="Comma, separated" /></label>
            <label class="tg"><span>Divider under the headline</span><input type="checkbox" role="switch" data-k="rule" /></label>
            <label class="tg"><span>Body text</span><input type="checkbox" role="switch" data-k="body" /></label>
            <label class="fld" data-if="body=true"><textarea rows="3" data-k="bodyText"></textarea></label>
            <label class="tg"><span>Boxes</span><input type="checkbox" role="switch" data-k="pairs" /></label>
            <div data-if="pairs=true">
              <label class="tg" data-if="about!="><span>From the item (CMS)</span><input type="checkbox" role="switch" data-k="pairsCms" /></label>
              <label class="fld" data-if="pairsCms=false">One per line: <code>Label | text</code>, * fills it <textarea rows="3" data-k="pairsText"></textarea></label>
            </div>
            <label class="tg"><span>Steps</span><input type="checkbox" role="switch" data-k="steps" /></label>
            <label class="fld" data-if="steps=true">One step per line <textarea rows="4" data-k="stepsText"></textarea></label>
            <label class="tg"><span>Tools</span><input type="checkbox" role="switch" data-k="tools" /></label>
            <details class="ms" data-if="tools=true">
              <summary data-ms-sum>Pick tools</summary>
              <div class="ms-list">{connectorNames.map((n) => <label class="ms-item"><input type="checkbox" data-tool={n} /><span>{n}</span></label>)}</div>
            </details>
            <div data-if="tools=true">
              <label class="tg"><span>Add your own</span><input type="checkbox" role="switch" data-k="toolsCustom" /></label>
              <div data-if="toolsCustom=true"><div class="owns" data-own></div><button type="button" class="btn ghost xs" data-act="own-add">+ Add a tool</button></div>
            </div>
            <label class="tg"><span>List</span><input type="checkbox" role="switch" data-k="list" /></label>
            <label class="fld" data-if="list=true">One per line: <code>Label | text</code> <textarea rows="4" data-k="listText"></textarea></label>
            <label class="tg"><span>GitHub mark</span><input type="checkbox" role="switch" data-k="github" /></label>
            <label class="tg"><span>Button</span><input type="checkbox" role="switch" data-k="button" /></label>
            <label class="fld" data-if="button=true"><input type="text" data-k="buttonText" /></label>
          </fieldset>
          <fieldset>
            <legend class="marker">Author</legend>
            <label class="tg"><span>Custom (not in the CMS)</span><input type="checkbox" role="switch" data-k="aCustom" /></label>
            <label class="fld" data-if="aCustom=false"><select data-k="author"><option value="">None</option>{data.authors.map((a) => <option value={a.id}>{a.name}</option>)}</select></label>
            <div data-if="aCustom=true">
              <label class="fld">Name <input type="text" data-k="aName" /></label>
              <label class="fld">Role, company <input type="text" data-k="aRole" /></label>
              <label class="fld">Photo URL <input type="text" data-k="aPhoto" placeholder="/authors/justin-rowe.jpg" /></label>
            </div>
          </fieldset>
        </div>

        <div class="pb-ptab" data-ptab="layout" hidden>
          <fieldset>
            <legend class="marker">Format</legend>
            <div class="cards fmt" data-seg="format">{FORMATS.map(([v, l, w, h]) => <button type="button" data-v={v}><i style={`aspect-ratio: ${w} / ${h}`}></i><b>{l}</b><small>{w}×{h}</small></button>)}</div>
          </fieldset>
          <fieldset>
            <legend class="marker">Layout</legend>
            <div class="cards lay" data-seg="layout">
              <button type="button" data-v="a"><i class="d-a"></i><b data-wide="Text left">Text first</b></button>
              <button type="button" data-v="b"><i class="d-b"></i><b data-wide="Art left">Art first</b></button>
              <button type="button" data-v="over"><i class="d-over"></i><b>Text on art</b></button>
              <button type="button" data-v="none"><i class="d-none"></i><b>Text only</b></button>
            </div>
            <p class="lbl-2">Text sits</p>
            <div class="seg" data-seg="vpos"><button type="button" data-v="start">Top</button><button type="button" data-v="center">Middle</button><button type="button" data-v="end">Bottom</button></div>
            <div class="seg" data-seg="align"><button type="button" data-v="left">Left</button><button type="button" data-v="center">Centred</button></div>
          </fieldset>
          <fieldset>
            <legend class="marker">Logo</legend>
            <label class="tg"><span>Logo</span><input type="checkbox" role="switch" data-k="logo" /></label>
            <div data-if="logo=true">
              <div class="seg" data-seg="logoKind"><button type="button" data-v="mark">Icon</button><button type="button" data-v="full">Full</button></div>
              <div class="seg" data-seg="logoPos"><button type="button" data-v="left">Left</button><button type="button" data-v="right">Right</button></div>
              <label class="fld">Size <input type="range" min="20" max="160" step="2" data-k="logoH" /></label>
            </div>
          </fieldset>
        </div>

        <div class="pb-ptab" data-ptab="art" hidden>
          <fieldset>
            <legend class="marker">Illustration</legend>
            <div class="cards kinds" data-seg="art.id">
              <button type="button" data-v="none"><b>None</b></button>
              <button type="button" data-v="wave"><b>Wave</b></button>
              <button type="button" data-v="photo"><b>Photo</b></button>
            </div>
            <div class="seg" data-artcat-tabs>
              <button type="button" data-artcat="item" data-if="about!=">This item</button>
              {artCats.map((c) => <button type="button" data-artcat={c.id}>{c.label}</button>)}
            </div>
            <div class="art-grid" data-artgrid data-cat="item"></div>
            {artCats.map((c) => (
              <div class="art-grid" data-artgrid data-cat={c.id} hidden>
                {c.items.map((n) => <button type="button" data-art={n} title={pretty(n)} aria-label={pretty(n)}></button>)}
                {c.alts.length > 0 && <p class="lbl-2 sub">Alternatives</p>}
                {c.alts.map((n) => <button type="button" data-art={n} title={pretty(n)} aria-label={pretty(n)}></button>)}
              </div>
            ))}
          </fieldset>
          <fieldset data-if="art.id!=none">
            <legend class="marker">Placement</legend>
            <div class="seg" data-seg="art.frame"><button type="button" data-v="bleed">To the edge</button><button type="button" data-v="panel">On a panel</button><button type="button" data-v="free">Free</button></div>
            <label class="fld">Zoom <input type="range" min=".5" max="3" step=".02" data-k="art.zoom" /></label>
            <label class="fld">Move ↔ <input type="range" min="-60" max="60" step="1" data-k="art.x" /></label>
            <label class="fld">Move ↕ <input type="range" min="-60" max="60" step="1" data-k="art.y" /></label>
            <div data-if="art.id!=photo">
              <label class="fld" data-if="art.id!=wave">Moment (still frame, and where the video starts) <input type="range" min="0" max="12" step=".05" data-k="art.t" /></label>
              <label class="tg"><span>Animate (exports as MP4)</span><input type="checkbox" role="switch" data-k="art.animate" /></label>
              <div data-if="art.id!=wave"><label class="tg"><span>Grey, accent on the live part</span><input type="checkbox" role="switch" data-k="art.mono" /></label></div>
            </div>
            <label class="fld" data-if="art.id=photo">Photo URL (empty = the author's) <input type="text" data-k="art.photo" /></label>
          </fieldset>
          <fieldset data-if="art.id=wave">
            <legend class="marker">Wave</legend>
            <div class="seg"><button type="button" data-wave-preset="brand">Brand</button><button type="button" data-wave-preset="cta">CTA blue</button><button type="button" data-wave-preset="mono">Grey</button></div>
            <div class="row colors">
              <label class="pick" aria-label="Wave colour 1"><input type="color" data-k="wave.c1" /></label>
              <label class="pick" aria-label="Wave colour 2"><input type="color" data-k="wave.c2" /></label>
              <label class="pick" aria-label="Wave colour 3"><input type="color" data-k="wave.c3" /></label>
              <label class="pick" aria-label="Wave ground"><input type="color" data-k="wave.ground" /></label>
              <span class="lbl-2">Ribbon · fold · ribbon · ground</span>
            </div>
            <label class="fld">Ribbon size <input type="range" min=".4" max="3" step=".02" data-k="wave.k" /></label>
            <label class="fld">Moment <input type="range" min="0" max="60" step=".1" data-k="wave.time" /></label>
          </fieldset>
        </div>

        <div class="pb-ptab" data-ptab="colour" hidden>
          <fieldset>
            <legend class="marker">Background</legend>
            <div class="sw" data-swatch="bg">
              <button type="button" data-v="black" style="--c: var(--neutral-1000)" aria-label="Black"></button>
              <button type="button" data-v="white" style="--c: var(--neutral-0)" aria-label="White"></button>
              {PASTELS.map((n) => <button type="button" data-v={`pastel-${n}`} style={`--c: var(--pastel-${n})`} aria-label={`Pastel ${n}`}></button>)}
              <label class="pick" aria-label="Custom background"><input type="color" data-k="bgCustom" /></label>
            </div>
          </fieldset>
          <fieldset>
            <legend class="marker">Accent</legend>
            <p class="hint">Illustration, quote mark, steps, colour band. Auto follows the background or the item.</p>
            <div class="sw" data-swatch="hue">
              <button type="button" data-v="auto" class="auto" aria-label="Auto">A</button>
              <button type="button" data-v="primary" style="--c: var(--primary-450)" aria-label="Primary blue"></button>
              {PASTELS.map((n) => <button type="button" data-v={String(n)} style={`--c: var(--pastel-${n}-450)`} aria-label={`Hue ${n}`}></button>)}
              <label class="pick" aria-label="Custom accent"><input type="color" data-k="hueCustom" /></label>
            </div>
          </fieldset>
          <fieldset>
            <legend class="marker">Structure</legend>
            <label class="tg"><span>Edge lines</span><input type="checkbox" role="switch" data-k="lines" /></label>
            <label class="tg"><span>Dot pattern</span><input type="checkbox" role="switch" data-k="pattern" /></label>
          </fieldset>
        </div>
      </form>

      <div class="pb-stage">
        <div class="pb-actions">
          <p class="lbl" data-size></p>
          <button type="button" class="btn filled sm" data-act="png">PNG 2x</button>
          <button type="button" class="btn brand sm" data-act="mp4">MP4</button>
          <button type="button" class="btn outlined sm" data-act="link">Copy link</button>
        </div>
        <div class="pb-progress" data-progress hidden><span></span></div>
        <div class="pb-fit" data-fit><div class="pb-scale" data-scale></div></div>
      </div>
    </section>
  </main>

  <!-- Prototypes: the IsoArt markup (and its scoped styles) the client clones for every figure it draws -->
  <div class="pb-protos" aria-hidden="true">
    <IsoArt name="sorter" still class="pb-proto-l" />
    <IsoArt name="sorter" dark still class="pb-proto-d" />
  </div>
  <p class="toast" data-toast role="status"></p>
</Base>

<script>
  import { boot } from '../builder';
  boot();
</script>

<style is:global>
  /* Builder chrome: site buttons, markers, underline fields, the DS toggle (§8.3) and a pill segmented control */
  .pb-bar { position: sticky; top: 0; z-index: var(--z-sticky); display: flex; align-items: center; gap: 24px; padding: 12px 24px; box-shadow: inset 0 -1px 0 var(--line); }
  .pb-bar img { height: 28px; width: auto; }
  .pb-bar .lbl { margin-right: auto; color: var(--text-2); }
  .pb-bar .seg { width: 240px; }
  .pb-view { animation: pb-in var(--t-base) var(--ease-out); }
  .pb-view[hidden], .pb-ptab[hidden], .pb-panel [hidden] { display: none !important; }
  .pb-ptab { animation: pb-in var(--t-base) var(--ease-out); }
  @keyframes pb-in { from { opacity: 0; transform: translateY(6px); } }
  .seg { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 2px; padding: 3px; border-radius: var(--radius-pill); background: var(--bg-muted); }
  .seg > button { min-height: 30px; padding: 0 10px; border: 0; border-radius: var(--radius-pill); background: none; color: var(--text-2); font: 600 11px/1.2 var(--font-mono); text-transform: uppercase; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), box-shadow var(--t-fast) var(--ease-out); }
  .seg > button[aria-selected=true] { background: var(--neutral-0); color: var(--neutral-950); box-shadow: 0 1px 3px #0000001f, inset 0 0 0 1px var(--line-card); }
  .surface-black .seg > button[aria-selected=true] { box-shadow: none; }
  .seg > button[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) { .seg > button:not([aria-selected=true]):hover { color: var(--text); } }
  .pb-gallery { padding: 48px 24px 120px; display: grid; gap: 48px; }
  .pb-intro { display: grid; gap: 12px; max-width: 760px; }
  .pb-groups { display: grid; gap: 56px; }
  .pb-group { display: grid; gap: 16px; }
  .pb-group > header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .pb-group > header .t-p2 { color: var(--text-2); }
  .pb-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .pb-card { display: grid; gap: 8px; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit; }
  .pb-thumb { position: relative; display: grid; place-items: center; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-4); background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); transition: box-shadow var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
