---
// One template for every rule page (Figma DS Report 919:23330): the rule, signs and what to do, who runs it, where it runs, previous/next.
// Shares the hero ticket, sidebar frame and section heads with the scenario and skill pages.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import DetailFrame from '../../components/detail/DetailFrame.astro';
import Sec from '../../components/Sec.astro';
import RelatedTabs from '../../components/detail/RelatedTabs.astro';
import SubmitBand from '../../components/SubmitBand.astro';
import DetailCta from '../../components/detail/DetailCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { T } from '../../site';
import { area } from '../../areas';
import ItemIcon from '../../components/ItemIcon.astro';
import { arrow } from '../../arrows';

export async function getStaticPaths() {
  const rules = (await getCollection('rules')).sort((a, b) => a.data.number - b.data.number);
  // Previous / next wrap around, so the first rule links back to the last and the last on to the first
  const at = (i: number) => (rules.length > 1 ? rules[(i + rules.length) % rules.length] : undefined);
  return rules.map((r, i) => ({ params: { slug: r.id }, props: { rule: r, prev: at(i - 1), next: at(i + 1) } }));
}
interface Props { rule: CollectionEntry<'rules'>; prev?: CollectionEntry<'rules'>; next?: CollectionEntry<'rules'> }
const { rule, prev, next } = Astro.props;
const { id, data: d } = rule;
const p = d.page;
const author = await getEntry(d.author);
const nn = (n: number) => String(n).padStart(2, '0');
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const applies = (await getCollection('skills', (s) => s.data.rules.some((r) => r.id === id))).sort(byOrder);
const skills = applies.filter((s) => s.data.status === 'ready');
const scenarios = (await getCollection('scenarios', (s) => s.data.rules.some((r) => r.id === id))).sort(byOrder);
const hasRule = p.advises || p.adds || p.reason;
// Run it lists everything, the ones built on this rule first (same as the skill page's Related)
const own = (ids: string[], x: string) => Number(ids.includes(x));
const skIds = applies.map((s) => s.id), scIds = scenarios.map((s) => s.id);
const ready = (s: { data: { status: string } }) => Number(s.data.status === 'ready');
const relSk = (await getCollection('skills')).sort((a, b) => own(skIds, b.id) - own(skIds, a.id) || ready(b) - ready(a) || a.data.order - b.data.order);
const relSc = (await getCollection('scenarios')).sort((a, b) => own(scIds, b.id) - own(scIds, a.id) || ready(b) - ready(a) || a.data.order - b.data.order);
const toc = [['h-rule', 'The rule', hasRule], ['h-signs', 'Decision triggers', p.signs.length], ['h-voices', 'What experts say', p.voices.length], ['h-run', 'Run it', true]]
  .filter(([, , on]) => on).map(([href, label]) => ({ label: label as string, href: `#${href}` }));
const ext = arrow('up', 'ext');
const unquote = (q: string) => q.trim().replace(/^["“„«]+|["”»]+$/g, ''); // some quotes arrive already wrapped
// Each voice with its author's photo, when the voice links an author page
const voices = await Promise.all(p.voices.map(async (v) => ({ ...v, photo: v.author ? (await getEntry(v.author))?.data.photo : undefined })));
const ini = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const count = (n: number, one: string, many: string) => (n === 1 ? one : `${n} ${many}`);
const cta = {
  headline: 'Run this rule differently?',
  context: 'Tell us where it breaks',
  note: 'Every rule in the Standard comes from a specialist’s own accounts. Send the case where it fails and the number you use instead, and we test it with you',
  button: 'Propose a change',
  ...p.cta,
};
---
<Base type="rule" title={`${d.title} · ${T.rules} · The B2B AI Standard for LinkedIn Ads`} description={d.why}>
  <DetailHero cover={area(d.area).cover} crumbs={[{ label: 'Collection', href: '/collection' }, { label: T.rules, href: '/rules' }, { label: d.title }]}
    chips={[{ label: area(d.area).title }, { label: `${T.rule} ${nn(d.number)}`, out: true }]} author={author} title={d.title} lead={d.lead ?? d.why}>
    <Fragment slot="actions">
      <a class="btn filled" href="#h-run">See where it runs</a>
      <a class="btn outlined" href="/rules">All {T.rules.toLowerCase()}</a>
    </Fragment>
    <ItemIcon slot="art" data={d} class="kart" />
  </DetailHero>

  <DetailFrame toc={toc}>
    {hasRule && (
      <Sec id="h-rule" label="The rule" title="What the Standard adds." context="On top of the default, and why it holds" small class="flush">
        {/* Read in order: the default, why the Standard's take holds, when it matters less, then the Standard's addition, highlighted last */}
        <div class="pair" data-reveal>
          {p.advises && (
            <div class="box">
              <p class="lbl-2 k">The default</p>
              <p class="t-p1">{p.advises.text}</p>
              {p.advises.source && (p.advises.url ? <a class="src ul" href={p.advises.url} rel="noopener">{p.advises.source}</a> : <p class="src">{p.advises.source}</p>)}
            </div>
          )}
          {p.reason && <div class="box"><p class="lbl-2 k">Why it holds</p><p class="t-p1 body">{p.reason}</p></div>}
          {p.mattersLess && <div class="box"><p class="lbl-2 k">When it matters less</p><p class="t-p1 body">{p.mattersLess}</p></div>}
          {p.adds && (
            <div class="box adds">
              <p class="lbl-2 k">What the Standard adds</p>
              <p class="t-p1">{p.adds}</p>
            </div>
          )}
        </div>
      </Sec>
    )}

    {p.signs.length > 0 && (
      <Sec id="h-signs" label="Decision triggers" title={`${count(p.signs.length, 'One sign', 'signs')} in your account.`} context="What you see on the left, what to do about it on the right" small class="flush">
        <table class="signs" data-reveal>
          <thead><tr><th class="lbl-2" scope="col">You see</th><th class="lbl-2" scope="col">Do this</th></tr></thead>
          <tbody>
            {p.signs.map((s) => <tr><th class="t-h6" scope="row">{s.see}</th><td class="t-p2 body">{s.do}</td></tr>)}
          </tbody>
        </table>
      </Sec>
    )}

    {voices.length > 0 && (
      <Sec id="h-voices" label="What experts say" title={`${count(voices.length, 'One specialist', 'specialists')} who check this.`} context="In their own words, with where they said it" small>
        {/* Two or fewer fill the width; more run in a rail with the home page's scroll lock */}
        <ul class:list={['voices', { 'rail scroll-snap-x': voices.length > 2 }]} data-voices={voices.length > 2 || undefined} data-reveal>
          {voices.map((v) => (
            <li class="voice">
              <svg class="qmark" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V13L7 0h6L9 12h5v12zm18 0V13l7-13h6l-4 12h5v12z" /></svg>
              <blockquote class="t-h6 q">{unquote(v.quote)}</blockquote>
              <div class="foot">
                <p class="by">
                  {v.photo ? <img class="ini" src={v.photo} alt="" width="40" height="40" loading="lazy" /> : <span class="ini" aria-hidden="true">{ini(v.name)}</span>}
                  <span>
                    <span class="t-p2">{v.author ? <a class="name ul" href={`/authors/${v.author.id}`}>{v.name}</a> : v.name}</span>
                    {(v.company || v.context) && <span class="t-p2 tone-2">{[v.company, v.context].filter(Boolean).join(' · ')}</span>}
                  </span>
                </p>
                {(v.source || (v.note && v.note.length <= 32)) && (
                  <p class="meta">
                    {v.note && v.note.length <= 32 && <span class="chip note">{v.note}</span>}
                    {v.source && (v.url ? <a class="src ul" href={v.url} rel="noopener">{v.source} <Fragment set:html={ext} /></a> : <span class="src">{v.source}</span>)}
                  </p>
                )}
                {v.note && v.note.length > 32 && <p class="src">{v.note}</p>}
              </div>
            </li>
          ))}
        </ul>
      </Sec>
    )}

    <Sec id="h-run" label="Run it" title={skills.length || scenarios.length ? 'Where it runs.' : 'Not in a skill yet.'} context={skills.length || scenarios.length ? 'The skills that apply it today and the scenarios built on it' : 'Apply it by hand for now, or send us the way you check it'} small>
      <RelatedTabs scenarios={relSc} skills={relSk} />
    </Sec>

    <DetailCta title={cta.headline} context={cta.context} button={cta.button} cover={area(d.area).cover}>
      <ItemIcon slot="art" data={d} class="kart" />
    </DetailCta>

    <nav class="pn" aria-label={`Other ${T.rules.toLowerCase()}`}>
      {[['pv', 'Previous', prev], ['nx', 'Next', next]].map(([cls, dir, r]) => r ? (
        <a class={cls} href={`/rules/${r.id}`} aria-label={`${dir} rule: ${r.data.title}`}>
          <span class="pic" style={`--cover-450: var(--pastel-${area(r.data.area).cover}-450)`}><ItemIcon data={r.data} class="pi" /></span>
          <span class="txt">
            <span class="kick"><span class="chip">{area(r.data.area).title}</span><span class="lbl num">{T.rule} {nn(r.data.number)}</span></span>
            <span class="t-h6 title">{r.data.title}</span>
          </span>
        </a>
      ) : <span />)}
    </nav>
  </DetailFrame>

  <SubmitBand />
  <SiteFooter />
</Base>

<script>
  import { wheelX } from '../../rail';
  document.querySelectorAll<HTMLElement>('[data-voices]').forEach(wheelX);
</script>

<style>
  .k { color: var(--text-2); }
  .src { margin-top: auto; padding-top: 8px; font-size: 13px; line-height: 1.4; color: var(--text-2); }
  .ul { border-bottom: 1px solid transparent; transition: border-color var(--t-fast) var(--ease-out); }

  /* The rule: up to four cards in a 2-column grid between the content lines, hairlines between them;
     the Standard's addition comes last, on black, so the eye ends on it */
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-inline: calc(-1 * var(--pad)); border-top: 1px solid var(--line); }
  .box { display: flex; flex-direction: column; gap: 12px; padding: 40px 32px; color: var(--text); }
  .box:nth-child(odd) { padding-left: var(--pad); }
  .box:nth-child(even) { padding-right: var(--pad); box-shadow: inset 1px 0 var(--line); }
  .box:nth-child(n + 3) { box-shadow: inset 0 1px var(--line); }
  .box:nth-child(even):nth-child(n + 3) { box-shadow: inset 1px 0 var(--line), inset 0 1px var(--line); }
  .box:last-child:nth-child(odd) { grid-column: 1 / -1; padding-right: var(--pad); }
  .box.adds { background: var(--neutral-950); color: var(--neutral-0); box-shadow: none; }
  .adds .k { color: var(--neutral-300); }

  /* Decision triggers: two-column table, dark rule under the head, hairlines between rows */
  .signs { width: 100%; border-collapse: collapse; text-align: left; }
  .signs thead th { padding-bottom: 12px; border-bottom: 2px solid var(--neutral-950); color: var(--text-2); font-weight: 600; }
  .signs th, .signs td { vertical-align: top; }
  .signs tbody th, .signs tbody td { padding-block: 24px; border-bottom: 1px solid var(--line); }
  .signs tbody th { width: 50%; padding-right: 40px; color: var(--text); }
  /* the section is flush: the last row ends on the next section's divider, no second line */
  .signs tbody tr:last-child > *, .signs tbody tr:last-child { border-bottom: 0; }

  /* What experts say: the home page's quote card on the tint (quote mark, quote at h6, author under it).
     Two or fewer share the width; more run in a rail, two and a bit in view so the next reads as "more to the right" */
  .voices { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: var(--gutter); }
  .voices.rail { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - 2 * var(--gutter)) / 2.2); margin-inline: calc(-1 * var(--pad)); padding-inline: var(--pad); scroll-padding-inline: var(--pad); }
  .voice { display: grid; grid-template-rows: auto 1fr auto; gap: 32px; min-width: 0; padding: 32px; border-radius: var(--radius-4); background: var(--bg-subtle); box-shadow: inset 0 0 0 1px var(--line-card); }
  .qmark { width: 28px; height: 21px; fill: var(--accent); }
  .q { margin: 0; color: var(--text); line-height: 1.4; text-wrap: pretty; }
  .foot { display: grid; gap: 16px; }
  .by { display: flex; align-items: center; gap: 12px; }
  .by > span:last-child { display: grid; }
  .by .name { color: var(--text); }
  .ini { object-fit: cover; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--bg-muted); font: 600 12px/1 var(--font-mono); flex: none; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .meta .src { margin: 0; padding: 0; }
  /* "Runs it differently": orange, the colour the site keeps for a specialist's own take */
  .chip.note { background: var(--secondary-300); color: var(--neutral-950); }
  .src { display: inline-flex; align-items: center; gap: 4px; justify-self: start; align-self: flex-start; }
  .src :global(svg) { width: 14px; height: 14px; flex: none; }

  /* Previous / next: two card-buttons splitting the row between the content lines */
  .pn { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 calc(-1 * var(--pad)) calc(-1 * var(--section-ruled-bottom)); border-top: 1px solid var(--line); } /* straight under the CTA, no gap, and last on the page: runs into the closing band */
  .pn > * + * { box-shadow: inset 1px 0 var(--line); }
  /* Each card: the rule's area figure (no tile, as in rule rows), then area chip + number and title; both left-aligned */
  .pn a { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 24px; align-items: center; padding: 40px var(--pad); transition: background-color var(--t-fast) var(--ease-out); } /* figure no taller than the text, so the space above and below match */
  .pic { display: block; aspect-ratio: 1; }
  .pic :global(.pi) { width: 100%; height: 100%; }
  .pic :global(.pi > *) { transition: transform 300ms var(--ease-out); }
  .txt { display: grid; gap: 12px; align-content: start; }
  .kick { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .num { color: var(--text-2); }
  .title { max-width: 32ch; }

  @media (hover: hover) and (pointer: fine) {
    .ul:hover { border-color: var(--text); }
    .pn a:hover { background: var(--bg-subtle); }
    .pn a:hover .pic :global(.pi > *) { transform: translateY(-2px); }
  }
  @media (max-width: 999px) {
    .voices:not(.rail) { grid-template-columns: 1fr; }
    .voices.rail { grid-auto-columns: calc((100% - var(--gutter)) / 1.3); }
  }
  @media (max-width: 699px) {
    .pair { grid-template-columns: 1fr; }
    .box { padding-inline: var(--pad); }
    .box:nth-child(n) { padding-inline: var(--pad); grid-column: auto; box-shadow: inset 0 1px 0 var(--line); }
    .box:first-child, .box.adds { box-shadow: none; }
    .voices.rail { grid-auto-columns: 88%; }
    .voice { padding: 24px; gap: 24px; }
    .signs thead { display: none; }
    .signs tbody tr { display: grid; gap: 8px; padding-block: 20px; border-bottom: 1px solid var(--line); }
    .signs tbody th, .signs tbody td { width: auto; padding: 0; border: 0; }
    .pn { grid-template-columns: 1fr; }
    .pn > * + * { box-shadow: inset 0 1px var(--line); }
    .pn > span { display: none; }
    .pn a { grid-template-columns: 80px minmax(0, 1fr); gap: 16px; }
  }
</style>
