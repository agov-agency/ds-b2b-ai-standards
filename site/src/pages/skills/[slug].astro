---
// One template for every skill page (Figma 919:23317), built on the scenario page's parts. Only ready skills get a page;
// "next version" cards link to their rule instead (SkillCard).
import { getCollection, getEntry, getEntries, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import DetailFrame from '../../components/detail/DetailFrame.astro';
import PromptTabs from '../../components/detail/PromptTabs.astro';
import StepFlow from '../../components/detail/StepFlow.astro';
import UsingTiles from '../../components/detail/UsingTiles.astro';
import Sec from '../../components/Sec.astro';
import RelatedTabs from '../../components/detail/RelatedTabs.astro';
import SubmitBand from '../../components/SubmitBand.astro';
import DetailCta from '../../components/detail/DetailCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { arrow } from '../../arrows';
import ItemIcon from '../../components/ItemIcon.astro';
import { T } from '../../site';
import { area } from '../../areas';

export async function getStaticPaths() {
  const ready = await getCollection('skills', (s) => s.data.status === 'ready');
  return ready.map((s) => ({ params: { slug: s.id }, props: { skill: s } }));
}
interface Props { skill: CollectionEntry<'skills'> }
const { skill } = Astro.props;
const d = skill.data;
const p = d.page;
const author = d.author ? await getEntry(d.author) : undefined;
const scenarios = await getCollection('scenarios', (s) => s.data.status === 'ready' && s.data.skills.some((k) => k.id === skill.id));
const rules = (await getEntries(d.rules)).sort((a, b) => a.data.number - b.data.number);
// Related rails list everything, this skill's own scenarios and rules first
const own = (ids: string[], id: string) => Number(ids.includes(id));
const scIds = scenarios.map((s) => s.id), ruIds = rules.map((r) => r.id);
const relSc = (await getCollection('scenarios')).sort((a, b) => own(scIds, b.id) - own(scIds, a.id) || Number(b.data.status === 'ready') - Number(a.data.status === 'ready') || a.data.order - b.data.order);
const relRu = (await getCollection('rules')).sort((a, b) => own(ruIds, b.id) - own(ruIds, a.id) || a.data.number - b.data.number);
const cover = d.cover ?? area(d.area).cover;
// What it does carries the step flow (no separate How it works), then the prompt (Pastel #15)
const toc = [['h-does', 'What it does', p.does], ['h-prompt', 'The prompt', p.prompt], ['h-when', 'When to use it', p.useWhen.length], ['h-related', 'Related', relSc.length + relRu.length]]
  .filter(([, , on]) => on).map(([id, label]) => ({ label: label as string, href: `#${id}` }));
const facts = [['Changes', d.changes], ['First run', d.firstRun]].filter(([, v]) => v) as [string, string][];
---
<Base type="skill" title={`${d.title} · ${T.skills} · The B2B AI Standard for LinkedIn Ads`} description={d.description}>
  <DetailHero cover={cover} crumbs={[{ label: 'Collection', href: '/collection' }, { label: T.skills, href: '/skills' }, { label: d.title }]}
    chips={[{ label: area(d.area).title }, { label: T.skill, out: true }]} author={author} title={d.title} lead={d.description} facts={facts}>
    <Fragment slot="actions">
      {p.prompt && <a class="btn filled" href="#h-prompt">Copy the prompt</a>}
      {p.prompt?.source && <a class="btn outlined" href={p.prompt.source} rel="noopener">Source on GitHub <Fragment set:html={arrow('up', 'ext')} /></a>}
    </Fragment>
    <ItemIcon slot="art" data={d} class="kart" />
  </DetailHero>

  <DetailFrame toc={toc}>
    {p.does && (
      <Sec id="h-does" label="What it does" title={p.does.headline} context={p.does.context} small>
        <div class="prose" data-reveal>{p.does.body.map((b) => <p class="t-p1 body">{b}</p>)}</div>
        {p.steps.length > 0 && (
          <div class="does-flow">
            <StepFlow bare steps={p.steps}>
              {p.stepsNote && <p class="t-h6 stop-note">{p.stepsNote.headline} {p.stepsNote.context && <span class="tone-2">{p.stepsNote.context}</span>}</p>}
            </StepFlow>
          </div>
        )}
      </Sec>
    )}

    {p.prompt && <PromptTabs headline={p.prompt.headline} context={p.prompt.context} tabs={p.prompt.tabs} install={p.prompt.install} />}

    {p.useWhen.length > 0 && <UsingTiles id="h-when" label="When to use it" headline={`${p.useWhen.length} moments it pays off.`} context="If one of these is this week, run it" items={p.useWhen} />}

    {(relSc.length > 0 || relRu.length > 0) && (
      <Sec id="h-related" label="Related" title={scenarios.length ? `Part of a ${T.scenario.toLowerCase()}.` : `The ${T.rules.toLowerCase()} it applies.`} context={p.partOf ?? (scenarios.length ? `Run it on its own, or as one step of the routine` : undefined)} small>
        <RelatedTabs scenarios={relSc} rules={relRu} />
      </Sec>
    )}
    <DetailCta cover={cover} {...(p.prompt
      ? { title: 'Run it on this quarter’s data.', context: 'Paste the prompt into your AI with your exports. It reads them and changes nothing', button: 'Copy the prompt', href: '#h-prompt' }
      : { title: `Built a ${T.skill.toLowerCase()} we don’t have yet?` })}>
      <ItemIcon slot="art" data={d} class="kart" />
    </DetailCta>
  </DetailFrame>

  <SubmitBand />
  <SiteFooter />
</Base>

<style>
  .prose { display: grid; gap: 20px; max-width: 680px; margin-top: calc(var(--gap-body) - var(--header-gap)); } /* the body belongs to the headline (DESIGN §6.6 headline -> body) */
  .does-flow { margin-top: 64px; }
  .body { color: var(--text-body); }

  .stop-note { max-width: 680px; padding-top: 32px; border-top: 1px solid var(--line); }

</style>
