  ['bell', [['searchlight', 'Прожектор'], ['telegraph', 'Телеграфний ключ']]],
  ['thermometer', [['swatches', 'Віяло колірних зразків'], ['weights', 'Набір еталонних гир']]],
  ['drilled', [['darts', 'Дартс'], ['stapler', 'Степлер крізь стос']]],
  ['sieve', [['prism', 'Призма розкладає промінь'], ['binrack', 'Стелаж із контейнерами']]],
  ['mirror', [['compass', 'Компас на карті'], ['archive', 'Архівна коробка з папками']]],
  ['bits', [['posterrack', 'Перекидний стенд з постерами'], ['cards', 'Віяло карт']]],
  ['dial', [['mixer', 'Мікшерний пульт'], ['scope', 'Осцилограф']]],
  ['abacus', [['merge', 'Три труби в одну'], ['loom', 'Джгут кабелів з одним розʼємом']]],
  ['patchpanel', [['flowmeter', 'Лічильник потоку з крильчаткою'], ['signpost', 'Вказівник із трьома стрілками']]],
];
const HUES = [5, 13, 9, 16, 1, 11, 6, 14];
const cover = (i: number) => { const n = HUES[i % HUES.length]; return `--cover: var(--pastel-${n}); --cover-200: var(--pastel-${n}-200); --cover-450: var(--pastel-${n}-450)`; };
// Every option for an item: this page's alternatives, the /art-alts batch, extras
const reviewAlts = (n: string) => [...ALT_RULES, ...ALT_SKILLS].find(([c]) => c === n)?.[1].map(([a, m]) => [`x-${a}`, m] as [string, string]) ?? [];
const options = (n: string) => [...(EXTRA[n] ?? []), ...reviewAlts(n), ...Object.entries(alts).filter(([, a]) => a.of === n || a.of === `i-${n}`).map(([a, x]) => [a, x.idea] as [string, string])];
const GROUPS: [string, string[][]][] = [['Сценарії', SCENARIOS], ['Скіли', SKILLS], ['Правила', RULES]];
const pieceOf = (h: string, n: string) => (h === 'Сценарії' ? n : `i-${n}`);
---
<Base title="Art review">
  <main class="rev">
    <p class="note">Поточна ілюстрація (перша, з рамкою), далі всі альтернативи до неї. Альтернатив немає в CMS, поки не обереш.</p>
    {GROUPS.map(([h, items]) => [<h2>{h}</h2>, items.map(([t, m, n], i) => {
      const opts = options(n);
      return (
        <section class="row" style={cover(i)}>
          <div class="t">{t}<span>{m}</span></div>
          <div class:list={['pics', { big: h === 'Сценарії' }]}>
            <figure class="cell cur"><IsoArt name={pieceOf(h, n)} field="var(--cover)" still={h !== 'Сценарії'} /><figcaption><code>{n}</code>поточна</figcaption></figure>
            {opts.map(([a, idea]) => <figure class="cell" data-alt={alts[a] ? a : undefined}><IsoArt name={a} field="var(--cover)" still={h !== 'Сценарії' || !!alts[a]} /><figcaption><code>{a.replace(/^[xi]-/, '')}</code>{idea}</figcaption></figure>)}
          </div>
        </section>
      );
    })])}
    <h2>Герої хабів і CTA</h2>
    <div class="pics big heroes">{HEROES.map(([t, n], i) => <figure class="cell" style={cover(i)}><IsoArt name={n} field="var(--cover)" /><figcaption><code>{n}</code>{t}</figcaption></figure>)}</div>
  </main>
</Base>
<script>
  // Alternatives from the /art-alts batch are not in `figures`, so IsoArt leaves them still; play the animated ones here
  import { alts } from '../art/alt';
  const hold = new URLSearchParams(location.search).get('t');
  const hosts = [...document.querySelectorAll<HTMLElement>('[data-alt]')].map((c) => ({ piece: alts[c.dataset.alt!].piece, frame: c.querySelector('[data-frame]')!, fig: c.querySelector<HTMLElement>('figure')! })).filter((h) => h.piece.period > 1);
  const show = (t: number) => { for (const h of hosts) { h.frame.innerHTML = h.piece.draw(t % h.piece.period); h.fig.style.setProperty('--march', String(-(t * 12) % 14)); } };
  if (hold !== null) show(Number(hold));
  else if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { const t0 = performance.now(); const tick = (now: number) => { show((now - t0) / 1000 * .6); requestAnimationFrame(tick); }; requestAnimationFrame(tick); }
</script>
<style>
  .rev { max-width: 1600px; margin: 0 auto; padding: 48px 24px 120px; }
  h2 { font: 500 32px/1.1 var(--font-sans, Inter); margin: 48px 0 16px; }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 24px; padding: 16px 0; border-top: 1px solid var(--neutral-100, #eee); }
  .t { font: 500 18px/1.4 Inter, sans-serif; }
  .t span { display: block; color: var(--neutral-500, #888); font-size: 16px; }
  .note { color: var(--neutral-500, #888); margin: 0 0 16px; }
  .pics { display: grid; grid-template-columns: repeat(auto-fill, 200px); gap: 12px; }
  .pics.big { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  .cell { margin: 0; }
  .cell :global(figure.iso-panel) { aspect-ratio: 1; width: 100%; }
  .cur :global(figure.iso-panel) { outline: 1px solid var(--neutral-950, #111); outline-offset: -1px; }
  figcaption { margin-top: 6px; font: 400 13px/1.4 Inter, sans-serif; color: var(--neutral-600, #666); }
  figcaption code { display: block; font: 600 11px/1.4 var(--font-mono, monospace); text-transform: uppercase; color: var(--neutral-950, #111); }
  .rev :global(figure.iso-panel) { --art-a: var(--cover-450); --art-b: var(--cover-450); --art-c: var(--cover-450); --lit: var(--cover-450); }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; } }
</style>
