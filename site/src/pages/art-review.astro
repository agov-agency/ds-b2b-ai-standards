---
// Temporary review page: every illustration in one place. Each item with its current figure or icon, then every
// alternative drawn for it (`x-<name>` from this page's batch, the /art-alts batch, the Competitor watch options), then the
// hub heroes. Alternatives are not in the CMS pools until picked. Not linked; delete after review.
// ?t=<seconds> holds every animated figure at that time instead of playing.
import Base from '../layouts/Base.astro';
import IsoArt from '../components/IsoArt.astro';
