const ALT_SKILLS: [string, [string, string][]][] = [
  ['turnstile', [['parkmeter', 'Паркомат'], ['farebox', 'Касовий автомат із квитком']]],
  ['regulator', [['throttle', 'Важіль газу на нижній зарубці'], ['dimmer', 'Димер і лампа, що ще світить']]],
  ['passcard', [['cardpunch', 'Компостер для карток'], ['coinpress', 'Прес для карбування жетонів']]],
  ['stanchions', [['boom', 'Шлагбаум'], ['guardcage', 'Захисна сітка над шестернями']]],
  ['adapter', [['stencil', 'Трафарет і його відбиток'], ['extruder', 'Екструзійна фільєра і профіль']]],
  ['keyrack', [['mailbox', 'Поштова скринька з піднятим прапорцем'], ['signal', 'Сигнальний ліхтар на щоглі']]],
  ['periscope', [['cctv', 'Камера спостереження'], ['radar', 'Радарна антена']]],
  ['clipboard', [['toolbox', 'Відкритий ящик з інструментами'], ['stethoscope', 'Стетоскоп на таці']]],
  ['gauge', [['filter', 'Фільтр з новим картриджем'], ['tuningfork', 'Камертон на резонаторі']]],
  ['tagcounter', [['sensorlamp', 'Ліхтар з датчиком руху над дверима'], ['tally', 'Ручний лічильник']]],
  ['charger', [['inkjet', 'Принтер і новий картридж'], ['tape', 'Диспенсер зі свіжим рулоном']]],
  ['reels', [['projector', 'Кінопроектор'], ['testcard', 'Монітор з тестовою таблицею']]],
  ['plug', [['clamp', 'Ремонтний хомут на трубі'], ['hob', 'Газова плита, конфорка вимкнена']]],
  ['trophies', [['ingots', 'Стоси злитків'], ['flags', 'Прапор на найвищому флагштоку']]],
  ['rulers', [['caliper', 'Штангенциркуль'], ['tapemeasure', 'Рулетка']]],
  ['logbook', [['binder', 'Папка на кільцях'], ['dotmatrix', 'Матричний принтер і стос звіту']]],
