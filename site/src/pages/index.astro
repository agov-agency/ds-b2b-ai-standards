---
// Home: the Standard's landing. Copy from the live site (the-ai-standard-site.netlify.app); structure from the brief of 26 Oct 2026.
// Black from the hero through the problem scene, white for the why-AI-fails block and the directory, black again for authors + form.
import { getCollection } from 'astro:content';
import { arrow } from '../arrows';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import IsoArt from '../components/IsoArt.astro';
import Problem from '../components/home/Problem.astro';
import Meet from '../components/home/Meet.astro';
import Why from '../components/home/Why.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { T } from '../site';

const nRules = (await getCollection('rules')).length;
// Opening statements: client copy, 28 Oct 2026
const quotes = [
  { name: 'Iurii Znak', company: 'DemandSense', text: 'There’s a trust problem with AI in LinkedIn Ads. The people we work with every day have tried it, and they still check every answer by hand. That’s why we built the Standard: one open set of rules for running LinkedIn Ads with AI, written with the experts and kept up to date.' },
  { name: 'AJ Wilcox', company: 'B2Linked', text: 'AI in LinkedIn Ads needs rules because it was trained on recommendations from the platform itself, and advanced practitioners all agree that taking LinkedIn’s recommendations for setting up your ads is a first-class ticket to negative ROI.' },
  { name: 'Justin Rowe', company: 'Impactable', photo: '/authors/justin-rowe.jpg', text: 'Pretty soon, everyone can “talk with your data”, but raw data needs to be interpreted with actual frameworks, doctrines, and a real point of view. That’s exactly what the Standard delivers.' },
];
// How the Standard is built: one card per library list, in build order, in a rail (two in view, the third off to the right)
const hubs = [
  { type: 'rule', art: 'rules', label: T.rules, href: '/rules', count: nRules, title: 'Start with the judgement AI is missing.', context: `When frequency is too high for an audience, when a CTR drop means fatigue, when an audience is big enough to count as warm. ${nRules} rules to start.` },
  { type: 'skill', art: 'skills', label: T.skills, href: '/skills', count: (await getCollection('skills')).length, title: 'Let AI apply the rules to your data.', context: 'A skill pulls your numbers, reads them the way the rules say, and tells you what to change.' },
  { type: 'scenario', art: 'scenarios', label: T.scenarios, href: '/scenarios', count: (await getCollection('scenarios')).length, title: 'Turn routine work into one run.', context: 'The Monday review across accounts, or the list of warm accounts for sales, done in one go. Each step is a skill, and each skill rests on a rule.' },
] as const;
const go = arrow('right', 'go');
const ini = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<Base title="The B2B AI Standard for LinkedIn Ads">

  <div class="top surface-black ruled">
    <SiteHeader />
    <section class="wrap hero" aria-labelledby="h-hero">
      <div class="copy">
        <h1 id="h-hero" class="headline t-h1">AI changed the game for LinkedIn Ads. <span class="tone-2">But nobody agreed on the rules.</span></h1>
        <p class="t-p1 body lead">A standard for making ads work with AI, without taking its word for it.</p>
        <div class="ctas">
          <a class="btn brand lg" href="/scenarios">See the scenarios <Fragment set:html={go} /></a>
          <a class="btn outlined lg" href="/rules">Read the {nRules} rules</a>
        </div>
      </div>
      <!-- Stand-in: the Scenarios hero piece until the home illustration is drawn -->
      <IsoArt name="scenarios" dark accent="scenario" zoom={1.5} class="hero-art" />
    </section>

    <section class="wrap quotes-sec" aria-labelledby="h-quotes">
      <div class="quotes-head">
        <p class="marker">Why we wrote it</p>
        <h2 id="h-quotes" class="headline t-h3">Why the Standard had to exist. <span class="tone-2">In the words of the people who run the accounts</span></h2>
      </div>
      <ul class="quotes cells-row to-edges" data-reveal>
        {quotes.map((q) => (
          <li class="quote">
            <blockquote>
              <p class="t-h6">“{q.text}”</p>
            </blockquote>
            <p class="by">{q.photo ? <img class="ini" src={q.photo} alt="" width="40" height="40" loading="lazy" /> : <span class="ini" aria-hidden="true">{ini(q.name)}</span>}<span><span class="t-p2">{q.name}</span><span class="t-p2 tone-2">{q.company}</span></span></p>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <main id="main">
    <Problem />

    <div class="ruled">
      <Why />

      <section class="blk wrap bleed dir" aria-labelledby="h-dir">
        <div class="dir-head">
          <p class="marker">Directory</p>
          <h2 id="h-dir" class="headline t-h3">How the Standard is built. <span class="tone-2">Each part builds on the one before it, and it all starts with the rules</span></h2>
        </div>
        <ul class="picks scroll-snap-x to-edges" data-picks data-reveal>
          {hubs.map((h) => (
            <li><a class="pick" data-type={h.type} href={h.href}>
              <span class="cover" aria-hidden="true"><IsoArt name={h.art} accent={h.type} mono zoom={1.3} /></span>
              <span class="txt">
                <span class="marker">{h.label}<span class="cnt">{String(h.count).padStart(2, '0')}</span></span>
                <span class="t-h4">{h.title} <span class="tone-2">{h.context}</span></span>
                <span class="more lbl">Explore all {h.count} {h.label.toLowerCase()} <Fragment set:html={arrow('right')} /></span>
              </span>
            </a></li>
          ))}
        </ul>
        <div class="below"><a class="btn brand lg" href="/directory">Explore full directory <Fragment set:html={go} /></a></div>
      </section>
    </div>

    <Meet />
  </main>

  <SiteFooter />
</Base>

<script>
  import { wheelX } from '../rail';
  // Same scroll lock as the Directory's scenario rail: the wheel runs the cards sideways, then the page carries on
  const picks = document.querySelector<HTMLElement>('[data-picks]');
  if (picks) wheelX(picks);
</script>

<style>
  .top { position: relative; background: var(--bg); color: var(--text); }

  /* Hero: copy on 6 columns; the art fills the other half from the header down and bleeds off the right */
  .hero { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: center; min-height: min(760px, calc(100svh - var(--site-bar))); padding-block: 64px; }
  .copy { position: relative; z-index: 1; grid-column: 1 / span 6; display: grid; gap: 24px; justify-items: start; }
  .copy .headline { max-width: 14em; }
  .lead { max-width: 30em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .hero :global(.hero-art) { grid-column: 7 / -1; align-self: stretch; margin: calc(-1 * var(--site-bar) - 64px) calc(-1 * var(--margin)) -64px 0; background: none; border-radius: 0; overflow: visible; pointer-events: none;
    --fade: linear-gradient(transparent, #000 160px, #000 calc(100% - 160px), transparent); -webkit-mask-image: var(--fade); mask-image: var(--fade); }
  /* Text arrives once: fade + 14px rise, staggered */
  :global(.motion-ready) .copy > * { animation: rise 600ms var(--ease-out) both; animation-delay: calc(var(--n) * 90ms + 100ms); }
  .copy > :nth-child(1) { --n: 0; } .copy > :nth-child(2) { --n: 1; } .copy > :nth-child(3) { --n: 2; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }

  /* Grid cells (as the Authors grid): the lines above and below run out to the vertical edge lines, 1px dividers between cells, no outer frame */
  .cells-row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0; margin-inline: calc(-1 * var(--edge-inset)); padding-inline: var(--edge-inset); border-block: 1px solid var(--line); }
  .cells-row > li + li { border-left: 1px solid var(--line); }

  /* Quotes: three static cells in a row; a snap rail on phones */
  .quotes-sec { display: grid; gap: var(--header-gap); padding-block: var(--section-ruled-top) var(--section-ruled-bottom); }
  .quotes-head { display: grid; gap: var(--gap-overline); }
  .quote { display: grid; grid-template-rows: 1fr auto; gap: 64px; min-height: 380px; padding: 32px; }
  .quote:first-child { padding-left: 0; } .quote:last-child { padding-right: 0; } /* outer cells line up with the grid */
  blockquote { display: grid; gap: 12px; align-content: start; margin: 0; }
  .by { display: flex; align-items: center; gap: 12px; }
  .by > span:last-child { display: grid; }
  blockquote p { text-wrap: pretty; }
  .ini { object-fit: cover; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--bg-muted); font: 600 12px/1 var(--font-mono); flex: none; }

  .blk { padding-block: var(--section-ruled-top) var(--section-ruled-bottom); }


  .dir-head { display: grid; gap: var(--gap-overline); justify-items: center; text-align: center; margin-bottom: var(--header-gap); }
  .dir-head .headline { max-width: 22em; }
  /* Big cards, one per library list: its hub art on top, marker + count, two-tone title, link label.
     Each keeps the half-width size; the rail holds two in view and the third waits off to the right, cropped at the edge lines */
  .picks { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--gutter)) / 2); gap: var(--gutter); }
  .picks > li { min-width: 0; }
  .pick { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: var(--radius-4); overflow: hidden; transition: background-color var(--t-fast) var(--ease-out); }
  .pick::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px var(--line-card); pointer-events: none; }
  .cover { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--bg-subtle); }
  .cover > :global(.iso-panel) { position: absolute; inset: 0; background: none; border-radius: 0; }
  /* Pale: the black heroes' look inverted for white. Light faces, pale grey hairlines, colour only on the live part */
  .pick .cover :global(.iso-art) { --line: color-mix(in srgb, var(--neutral-300) 60%, var(--neutral-200)); }
  .pick .cover :global(.iso-art .f) { stroke: var(--line); stroke-width: .8; }
  .pick .cover :global(.iso-art .det) { stroke: var(--neutral-100); stroke-width: .6; }
  .pick .cover :global(.iso-art :is(.paper, .body)) { fill: var(--neutral-0); }
  .pick .cover :global(.iso-art .tint) { fill: var(--neutral-25); }
  .pick .cover :global(.iso-art .blk) { fill: var(--neutral-50); }
  .pick .cover :global(.iso-art .head) { fill: var(--line); }
  .pick .cover :global(.iso-art .dash) { stroke: var(--line); stroke-width: 1.2; }
  .pick .cover :global(.iso-art .lit .f) { stroke: var(--lit, var(--h)); }
  .pick .cover :global(.iso-art .lit .det) { stroke: color-mix(in srgb, var(--lit, var(--h)) 45%, #fff); }
  .pick .cover :global(.iso-art .lit .paper) { fill: color-mix(in srgb, var(--lit, var(--h)) 12%, #fff); }
  .pick .cover :global(.iso-art .lit .tint) { fill: color-mix(in srgb, var(--lit, var(--h)) 25%, #fff); }
  .pick .cover :global(.iso-art .lit .body) { fill: color-mix(in srgb, var(--lit, var(--h)) 55%, #fff); }
  .txt { display: grid; grid-template-rows: auto 1fr auto; gap: 12px; padding: 32px; }
  .cnt { margin-left: 6px; padding: 0 6px; border-radius: var(--radius-2); background: var(--bg-muted); color: var(--text-body); font-variant-numeric: tabular-nums; }
  .txt .t-h4 { max-width: 24em; text-wrap: balance; }
  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; color: var(--text); }
  .more :global(svg) { width: 16px; height: 16px; transition: translate var(--t-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .pick:hover { background: var(--bg-subtle); } .pick:hover .more :global(svg) { translate: 4px 0; } }
  .below { display: flex; justify-content: center; margin-top: 48px; }

  @media (max-width: 999px) {
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .copy { grid-column: 1; }
    .hero :global(.hero-art) { display: none; }
    .quotes { grid-auto-columns: min(80%, 420px); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--edge-inset)); padding-inline: var(--edge-inset); scroll-padding-inline: var(--edge-inset); }
    .quote { scroll-snap-align: start; min-height: 300px; }
    .quote:first-child { padding-left: 0; } .quote:last-child { padding-right: 32px; }
  }
  @media (max-width: 699px) {
    .hero { padding-block: 40px; }
    .ctas > .btn { flex: 1 1 100%; }
    .quote { padding: 24px; }
    .picks { grid-auto-columns: 88%; }
    .txt { padding: 24px; }
    .below > .btn { flex: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    @keyframes rise { from { opacity: 0; } }
  }
</style>
