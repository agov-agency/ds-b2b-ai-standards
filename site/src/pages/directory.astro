---
import { arrow } from '../arrows';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import IsoArt from '../components/IsoArt.astro';
import TabBar from '../components/TabBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import ScenarioCard from '../components/ScenarioCard.astro';
import SkillCard from '../components/SkillCard.astro';
import RuleRow from '../components/RuleRow.astro';
import AuthorCard from '../components/AuthorCard.astro';
import AuthorMarquee from '../components/AuthorMarquee.astro';
import SubmitBand from '../components/SubmitBand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { T } from '../site';
import { AREA_LIST } from '../areas';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
// Ready first, then what's coming: the slider shows the library's breadth, not just the two live ones
const scenarios = (await getCollection('scenarios')).sort((a, b) => (a.data.status === b.data.status ? byOrder(a, b) : a.data.status === 'ready' ? -1 : 1));
const allSkills = await getCollection('skills');
const skills = allSkills.sort((a, b) => (a.data.status === b.data.status ? byOrder(a, b) : a.data.status === 'ready' ? -1 : 1));
const areas = AREA_LIST.map((a) => [a.id, a.title] as const);
const two = (n: number) => String(n).padStart(2, '0');
// Six rules, featured first, then by number
const rules = (await getCollection('rules')).sort((a, b) => (a.data.featured === b.data.featured ? a.data.number - b.data.number : a.data.featured ? -1 : 1)).slice(0, 6);
const nRules = (await getCollection('rules')).length;
const authors = (await getCollection('authors', (a) => a.data.featured)).sort(byOrder);
const go = arrow('right', 'go');
const small = arrow('right');
---
<Base title="Directory · The B2B AI Standard for LinkedIn Ads">

  <div class="top surface-black">
    <SiteHeader />
    <div class="wrap hero has-art">
      <IsoArt name="directory" dark place={[-146, -166, 915, 972]} clip={770} class="hero-art" />
      <div class="copy">
        <Breadcrumbs items={[{ label: 'Directory' }]} />
        <h1 class="headline t-display">The directory. <span class="tone-2">Every rule, skill and scenario in the Standard, so your AI can make sense of LinkedIn Ads data</span></h1>
      </div>
      <AuthorMarquee />
    </div>
  </div>
  <TabBar />

  <main id="main">
    <div class="ruled">
    <section class="blk wrap" data-type="scenario" aria-labelledby="h-scenarios">
      <SectionHead id="h-scenarios" marker={T.scenarios} count={scenarios.length} title="Run the usual prep work in one go." context="A scenario runs several skills in order, on your schedule">
        <button class="btn outlined icon xs desk" type="button" data-rail-prev aria-label="Previous scenarios" disabled><Fragment set:html={arrow('left')} /></button>
          <button class="btn filled icon xs desk" type="button" data-rail-next aria-label="Next scenarios"><Fragment set:html={small} /></button>
      </SectionHead>
      <ul class="rail scroll-snap-x to-edges" data-rail data-reveal>
        {scenarios.map((s) => <li><ScenarioCard scenario={s} wide /></li>)}
      </ul>
      <div class="below">
        <a class="btn brand" href="/scenarios">Explore all {scenarios.length} {T.scenarios.toLowerCase()} <Fragment set:html={go} /></a>
      </div>
    </section>

    <section class="blk wrap bleed" data-type="skill" aria-labelledby="h-skills">
      <SectionHead id="h-skills" marker={T.skills} count={allSkills.length} title="Answer a specific question about your account." context="A skill checks your data against the rules and tells you what it found" />
      <div class="areas" role="group" aria-label="Filter by area" data-areas>
        <button class="fchip" type="button" aria-pressed="true" data-area="">All <span class="n">{two(skills.length)}</span></button>
        {areas.map(([key, label]) => (
          <button class="fchip" type="button" aria-pressed="false" data-area={key}>{label} <span class="n">{two(skills.filter((s) => s.data.area.id === key).length)}</span></button>
        ))}
      </div>
      <ul class="grid4" data-reveal data-grid>
        {skills.map((s, i) => <li data-area={s.data.area.id} hidden={i >= 8} data-more={i >= 4 ? '' : undefined}><SkillCard skill={s} /></li>)}
      </ul>
      <div class="below"><a class="btn brand" href="/skills">See all {allSkills.length} {T.skills.toLowerCase()} <Fragment set:html={go} /></a></div>
    </section>

    <section class="blk wrap bleed" data-type="rule" aria-labelledby="h-rules">
      <SectionHead id="h-rules" marker={T.rules} count={nRules} title="Set the rules your AI works by." context="Each one shows what LinkedIn does by default and what to do on top of it" />
      <ul class="rule-grid" data-reveal>
        {rules.map((r) => <li><RuleRow rule={r} /></li>)}
      </ul>
      <div class="below"><a class="btn brand" href="/rules">Explore all {nRules} {T.rules.toLowerCase()} <Fragment set:html={go} /></a></div>
    </section>

    </div>

    <!-- Authors run on black into the closing band, with their own edge lines -->
    <div class="surface-black ruled">
    <section class="blk wrap last" aria-labelledby="h-authors">
      <SectionHead id="h-authors" marker="Featured authors" title="The people behind the work." context="Each skill and scenario was tested on real accounts by actual hands-on experts managing top B2B accounts">
        <button class="btn outlined icon xs desk" type="button" data-rail-prev aria-label="Previous authors" disabled><Fragment set:html={arrow('left')} /></button>
        <button class="btn filled icon xs desk" type="button" data-rail-next aria-label="Next authors"><Fragment set:html={small} /></button>
      </SectionHead>
      <ul class="rail cells scroll-snap-x to-edges" data-rail data-reveal>
        {authors.map((a) => <li><AuthorCard author={a} /></li>)}
      </ul>
      <div class="below"><a class="btn brand" href="/authors">Explore all {authors.length} {T.authors.toLowerCase()} <Fragment set:html={go} /></a></div>
    </section>
    </div>
  </main>

  <SubmitBand />
  <SiteFooter />
</Base>

<script>
  import { rail, wheelX } from '../rail';
  // Rails (scenarios, authors): each section's arrows step one card; disabled at the ends. The wheel scrolls them sideways
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((r) => {
    const sec = r.closest('section')!;
    const prev = sec.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = sec.querySelector<HTMLButtonElement>('[data-rail-next]');
    if (prev && next) r.addEventListener('scroll', rail(() => r, prev, next), { passive: true });
    wheelX(r);
  });

  // Skills area chips: All shows the first eight, an area shows all of its own (six); phones keep the first four of either
  const chips = document.querySelector('[data-areas]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] > li')];
  chips?.querySelectorAll<HTMLButtonElement>('[data-area]').forEach((b) => b.addEventListener('click', () => {
    chips.querySelectorAll('[data-area]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let shown = 0;
    for (const li of cards) {
      li.hidden = b.dataset.area ? li.dataset.area !== b.dataset.area : shown >= 8;
      if (!li.hidden) li.toggleAttribute('data-more', shown++ >= 4);
    }
  }));
</script>

<style>
  .top { position: relative; overflow: hidden; background: var(--bg); color: var(--text); }
  .top > :global(:not(.site-header)) { position: relative; }
  /* Same hero rhythm as the hub pages, so the title doesn't jump when switching tabs */
  .hero { padding-block: 40px; }
  .copy { display: grid; gap: 24px; }
  .copy .headline { max-width: 760px; min-height: 4lh; } /* room for four lines on every hub, so the tabs sit the same distance below */

  .blk { padding-block: var(--section-ruled-top) var(--section-ruled-bottom); }
  .last { padding-bottom: 0; } /* the black closing band follows with its own top padding */

  /* Rail: the hub's wide card at 8 columns, so the next one shows; cropped at the edge lines */
  .rail { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 11 * var(--gutter)) / 12 * 8 + 7 * var(--gutter)); gap: var(--gutter); }
  .rail > li { min-width: 0; }
  /* Grid cards: no gaps, cells split by 1px lines; the lines above and below belong to the cards, so they stop at the cards instead of reaching the edge lines */
  .cells { grid-auto-columns: 25%; gap: 0; }
  .cells > li { border-block: 1px solid var(--line); }
  .cells > li { box-shadow: inset 1px 0 var(--line); }
  .cells > li:last-child { box-shadow: inset 1px 0 var(--line), inset -1px 0 var(--line); }

  .areas { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  .grid4 > li[hidden] { display: none; }
  /* Cards that come back after a filter change fade up instead of popping in */
  .grid4 > li { animation: skill-in 240ms var(--ease-out); }
  @keyframes skill-in { from { opacity: 0; translate: 0 8px; } }
  @media (prefers-reduced-motion: reduce) { .grid4 > li { animation: none; } }
  .below { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 40px; }

  @media (max-width: 999px) {
    .rail { grid-auto-columns: 85%; }
    .cells { grid-auto-columns: 50%; }
    .grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 699px) {
    .hero { padding-block: 24px; }
    .rail { grid-auto-columns: 88%; }
    .cells { grid-auto-columns: 80%; }
    .grid4 { grid-template-columns: 1fr; }
    .grid4 > li[data-more] { display: none; }
    .below { margin-top: 24px; }
    .below > .btn { flex: 1; }
  }
</style>
